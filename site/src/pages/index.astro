---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { SITE } from '../consts';
import { FAQS, PROOF, OFFERS, ENGINES } from '../data/content';
import { getCollection } from 'astro:content';

const pieces = (await getCollection('research'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/#service`,
  name: 'Answer engine optimisation',
  serviceType: 'Answer engine optimisation',
  description: SITE.description,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  url: `${SITE.url}/service`,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* Illustrative shape only — invented statuses, stated as such on the page. */
const demoRows = [
  { label: 'Best employment lawyer in [city]', note: 'buying intent', cells: [
    { status: 'present' as const, citation: 'directory listing' },
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'named, not ranked' },
    { status: 'absent' as const },
  ]},
  { label: 'Alternatives to [incumbent]', note: 'comparison', cells: [
    { status: 'absent' as const },
    { status: 'present' as const, citation: 'own comparison page' },
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'listed sixth' },
  ]},
  { label: 'Who are the top [category] firms', note: 'discovery', cells: [
    { status: 'present' as const, citation: 'trade press' },
    { status: 'present' as const, citation: 'trade press' },
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'local pack only' },
  ]},
  { label: '[brand] vs [competitor]', note: 'head to head', cells: [
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'competitor page' },
    { status: 'absent' as const },
    { status: 'absent' as const },
  ]},
];

const heroTiles = [
  { n: '01', t: 'Measured', d: 'Four engines, clean sessions, recorded one by one.' },
  { n: '02', t: 'Diagnosed', d: 'Absence has causes. They are not the same cause.' },
  { n: '03', t: 'Executed', d: 'Entity, content and earned placement.' },
  { n: '04', t: 'Proved', d: 'Re-measured against a control set.' },
];
---

<BaseLayout
  title={SITE.name}
  description="Brandure measures where your brand appears in AI-generated answers across ChatGPT, Perplexity, Gemini and Google — then does the work that changes it. Request a free visibility report."
  schemas={[serviceSchema, faqSchema]}
>
  <!-- 2. Hero — full bleed, asymmetric, gradient wash -->
  <section class="hero">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__blob mesh__blob--1"></div>
      <div class="mesh__blob mesh__blob--2"></div>
      <div class="mesh__blob mesh__blob--3"></div>
    </div>
    <div class="wrap hero-grid">
      <div data-load>
        <p class="eyebrow">Answer engine optimisation</p>
        <h1 class="statement" data-split>Your buyers asked an AI. You were not the answer.</h1>
        <p class="lede">
          We measure where you stand inside AI-generated answers, against the
          competitors you actually lose to — then do the work that moves it.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#report">Get a free visibility report</a>
          <a class="textlink" href="/service">See how the work runs &rarr;</a>
        </div>
      </div>
      <div class="hero-tiles" data-stagger>
        {heroTiles.map((t) => (
          <div class="card card--tilt">
            <span class="mono" style="color:var(--blue)">{t.n}</span>
            <p class="tile-title">{t.t}</p>
            <p style="margin:0;font-size:var(--step--1);color:var(--muted)">{t.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Proof band — tinted, dense, wide -->
  <section class="section section--tight section--sunk">
    <div class="wrap">
      <div class="figure-row" data-stagger>
        {PROOF.map((p) => (
          <div class="figure">
            <span class="figure__n" data-count={p.n}>{p.n}</span>
            <span class="figure__l">{p.label}</span>
          </div>
        ))}
      </div>
      <p class="figure__src" style="margin-top:1.5rem">
        Figures describe our own first category scan and its method, not client outcomes. Dubai, August 2026.
      </p>
    </div>
  </section>

  <!-- 4. The problem — narrow, airy, plain surface -->
  <section class="section">
    <div class="wrap-narrow" data-reveal>
      <p class="eyebrow">The problem</p>
      <h2>Absence is the failure state, and it is invisible</h2>
      <p>
        A search engine returns ten links and lets the buyer choose. An answer
        engine returns a conclusion and has already chosen. By the time your
        category comes up, the shortlist is made.
      </p>
      <p>
        Nobody tells you when you are left out. There is no rank to slip, no
        impression count to fall. The buyer asks, gets three names, and none of
        them is yours — and the first you hear of it is a quarter of soft
        pipeline nobody can explain.
      </p>
    </div>
  </section>

  <!-- 5. Four surfaces — INVERTED band, dense table, full bleed. Centrepiece. -->
  <section class="section section--inv">
    <div class="wrap" data-reveal>
      <p class="eyebrow">The four-surface point</p>
      <h2 class="statement" style="font-size:var(--step-4)" data-split>One question. Four different answers.</h2>
      <p class="lede" style="max-width:44rem">
        The engines disagree with each other far more than most people expect.
        Same question, same day, different brands named and different sources
        cited. "We show up in ChatGPT" tells you nothing about the other three
        quarters of the surface area.
      </p>
      <ComparisonTable
        caption="How a visibility report is laid out"
        columns={[...ENGINES]}
        rows={demoRows}
        footnote="Layout illustration. Every status above is invented to show the format — none is a finding about a real brand. Real reports carry the verbatim prompt set, the market, the date and the number of runs per prompt."
      />
    </div>
  </section>

  <!-- 6. How it works — plain surface, horizontal steps -->
  <section class="section">
    <div class="wrap" data-reveal>
      <p class="eyebrow">How it works</p>
      <h2>Four stages, and the last one is the point</h2>
      <ol class="steps" data-stagger>
        <li><h3>Baseline</h3><p>A frozen prompt set, run across all four engines from clean sessions. Market agreed, never assumed.</p></li>
        <li><h3>Diagnose</h3><p>Whether a model cannot resolve you, cannot find you in its sources, or simply prefers someone else.</p></li>
        <li><h3>Execute</h3><p>Entity and structured-data work, answer-shaped content, and placement into the sources models actually cite.</p></li>
        <li><h3>Re-measure</h3><p>Same prompts, plus a control set left untouched — so the change can be attributed rather than asserted.</p></li>
      </ol>
    </div>
  </section>

  <!-- 7. Offers — tinted band, cards, prices -->
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Engagements</p>
      <h2>Two ways in</h2>
      <p class="lede">Capacity is deliberately capped. The audit is the front door and stands on its own.</p>
      <div class="grid grid--2" style="margin-top:2rem" data-stagger>
        {OFFERS.map((o) => (
          <div class="card offer">
            <h3 style="margin-bottom:0.2rem">{o.name}</h3>
            <span class="offer__price">{o.price}</span>
            <span class="offer__unit">{o.unit}</span>
            <p style="font-size:var(--step--1)">{o.summary}</p>
            <ul>{o.includes.map((i) => <li>{i}</li>)}</ul>
            <a class:list={['btn', !o.primary && 'btn--ghost']} href={o.primary ? '#report' : '/service'}>{o.cta}</a>
          </div>
        ))}
      </div>
      <p style="margin-top:1.4rem"><span class="sample-flag">Sample pricing</span> &nbsp;Figures are placeholders for layout. Real pricing is set before launch.</p>
    </div>
  </section>

  <!-- 8. Research teaser — plain surface, editorial cards -->
  <section class="section">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Research</p>
      <h2>We publish what we measure</h2>
      <p class="lede">Method attached, so any finding can be checked or repeated rather than taken on trust.</p>
      <div class="grid grid--3" style="margin-top:2rem" data-stagger>
        {pieces.map((p) => (
          <a class="card card--link card--tilt" href={`/research/${p.id}`}>
            <p class="meta">
              <time datetime={p.data.published.toISOString().slice(0, 10)}>{p.data.published.toISOString().slice(0, 10)}</time>
              <span class="tag">{p.data.vertical}</span>
              {p.data.placeholder && <span class="tag tag--draft">Placeholder</span>}
            </p>
            <h3 style="font-size:var(--step-1)">{p.data.title}</h3>
            <p style="font-size:var(--step--1);color:var(--muted)">{p.data.description}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:1.6rem"><a class="textlink" href="/research">All research &rarr;</a></p>
    </div>
  </section>

  <!-- 9. Objections — narrow, dense accordion -->
  <section class="section section--sunk">
    <div class="wrap-narrow" data-reveal>
      <p class="eyebrow">Objections</p>
      <h2>The questions we get asked</h2>
      <div class="qa" style="margin-top:1.75rem" data-stagger>
        {FAQS.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. CTA — INVERTED band, full section -->
  <section class="section section--inv" id="report">
    <div class="wrap">
      <div class="hero-grid">
        <div class="reveal">
          <p class="eyebrow">Free report</p>
          <h2 class="statement" style="font-size:var(--step-4)" data-split>Find out what the engines say about you.</h2>
          <p class="lede">
            We run your category across all four surfaces and send you what comes
            back — who gets named, in what order, and which sources the answers
            were built from. No charge, no obligation, no sequence.
          </p>
        </div>
        <ReportForm id="report-form" inverted />
      </div>
    </div>
  </section>
</BaseLayout>
