---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';

/* RESEARCH IS AN INDEX, NOT AN ARGUMENT. Rewritten 2026-08-29 on instruction.

   It previously ran the same shape as /service and /method — a five-step
   method spine, three publication refusals, and a full write-up of a finding
   we withdrew after finding half a scan contaminated. That put the detail in
   the headings, so the page read as a case being argued rather than a shelf of
   work, and it gave away the substance of a piece before the piece existed.

   Now: a hero, the pieces as large cards, a way through to each one. Anything
   about how a scan runs or what disqualifies a result belongs inside an
   individual piece, where the reader has asked for it.

   NOTHING IS DELETED. SCAN_STEPS, REFUSALS, WITHDRAWN and AIO_COVERAGE all
   still live in src/data/research.ts, unused by this page. The withdrawn
   finding in particular is worth publishing as a piece in its own right rather
   than as a section here — it is the only thing on the site that costs us
   something to say. */

const all = (await getCollection('research')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const anyReal = all.some((p) => !p.data.placeholder);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/research#collection`,
  name: 'Research',
  description:
    'Answer engine research published by Brandure. Every piece carries the questions asked, the market, the engines and the run count.',
  url: `${SITE.url}/research`,
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---
<BaseLayout
  title="Research"
  description="The research we've conducted on AI Search. Every piece carries the exact questions we asked, the market, the engines and how many times we ran it."
  schemas={[schema]}
>
  <!-- 1. Hero. Centred and short, because the pieces are the page. -->
  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap res-hero" data-load>
      <p class="eyebrow">Research</p>
      <h1 class="statement" data-split>We show our working.</h1>
      <p class="lede">
        Most AI visibility statistics you&rsquo;ll read come from asking one
        engine one question, once, with no list of what was asked. Here&rsquo;s
        how we do it instead.
      </p>
    </div>
  </section>

  <!-- 2. The pieces. Large cards, one per row on a wide screen, so the title
       and the summary carry the weight rather than a thumbnail grid. -->
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Research we&rsquo;ve conducted</h2>
        <p class="lede">
          Every piece carries the exact questions we asked, the market, the
          engines and how many times we ran it.
        </p>
      </div>

      {!anyReal && (
        <p class="tst__warn">
          <strong>Nothing is published yet.</strong> The entries below show the
          format and contain no findings. They&rsquo;re hidden from search
          engines and will be deleted rather than tidied up.
        </p>
      )}

      {all.length === 0 ? (
        <p class="center-row">Nothing published yet.</p>
      ) : (
        <ol class="rlist" data-stagger>
          {all.map((p, i) => (
            <li class="rlist__i">
              <a class="rcard" href={`/research/${p.id}`}>
                <span class="rcard__i" aria-hidden="true">{String(all.length - i).padStart(2, '0')}</span>

                <div class="rcard__body">
                  <p class="rcard__meta">
                    <span class="tag">{p.data.vertical}</span>
                    <time datetime={p.data.published.toISOString().slice(0, 10)}>{fmt(p.data.published)}</time>
                    {p.data.updated && (
                      <span class="rcard__upd">Updated {fmt(p.data.updated)}</span>
                    )}
                    {p.data.placeholder && <span class="tag tag--draft">Placeholder</span>}
                  </p>

                  <h3 class="rcard__t">{p.data.title}</h3>
                  <p class="rcard__d">{p.data.description}</p>

                  <p class="rcard__go">
                    Read the research
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 12h15M13 6l6 6-6 6"/>
                    </svg>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <!-- 3. CTA. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="cta-card">
        <span class="cta-card__glint" aria-hidden="true"><span class="cta-card__sheen"></span></span>
        <div>
          <h2>Your category, measured the same way</h2>
          <p class="lede">
            Same method, same disclosure: the questions, the market, the run
            count, and where every mention came from. No charge, and nobody will
            chase you afterwards.
          </p>
        </div>
        <a class="btn cta-card__btn" href="/#report">Show me where I stand</a>
      </div>
    </div>
  </section>
</BaseLayout>
