---
/**
 * Free visibility report request. Netlify Forms — no third-party embed, no
 * client-side handler. The honeypot plus Netlify's built-in spam filtering
 * cover abuse. Submission confirmation is shown on the page via the success
 * parameter rather than a redirect to a separate page.
 */
interface Props { id: string; heading?: string; blurb?: string; inverted?: boolean; }
const {
  id,
  heading = 'Get your free visibility report',
  /* Deliberately short. This sits directly beneath a CTA that has already
     made the pitch, and the old blurb repeated that pitch almost sentence for
     sentence. The form's own intro should add what the CTA doesn’t: the
     format and the turnaround. */
  /* Changed 2026-09-03 with the pricing sheet, which delivers the free report
     on a call rather than as a document. The pricing card and this form are
     the same offer and were promising two different things. */
  blurb = 'We’ll walk you through it on a 15-minute call. You keep the report either way.',
  inverted = false,
} = Astro.props;
/* NO SUCCESS STATE HERE. This used to branch on
   `Astro.url.searchParams.get('submitted')`, which on a static build is
   evaluated at build time — where the query string is always absent — so the
   success markup was never in the shipped HTML. Netlify captured every
   submission, redirected back to this same page, and the visitor saw an empty
   form and assumed it had failed. The confirmation is a real route now:
   /thanks. */
---
<section class:list={['card', inverted && 'card--inv']} id={id} aria-labelledby={`${id}-h`}
         style="padding:1.6rem">
  <h3 id={`${id}-h`} style="margin-top:0">{heading}</h3>

  {!inverted && <p style="font-size:var(--small)">{blurb}</p>}
      <form name="report-request" method="POST" action="/thanks"
            data-netlify="true" netlify-honeypot="company-website-2" data-track="report">
        <input type="hidden" name="form-name" value="report-request" />
        <p class="hp"><label>Leave this empty<input name="company-website-2" tabindex="-1" autocomplete="off" /></label></p>

        <div class="form-grid">
          <div class="field">
            <label for={`${id}-name`}>Name</label>
            <input id={`${id}-name`} type="text" name="name" autocomplete="name" required />
          </div>
          <div class="field">
            <label for={`${id}-email`}>Work email</label>
            <input id={`${id}-email`} type="email" name="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for={`${id}-company`}>Company</label>
            <input id={`${id}-company`} type="text" name="company" autocomplete="organization" required />
          </div>
          <div class="field">
            <label for={`${id}-url`}>Website</label>
            <input id={`${id}-url`} type="url" name="website" placeholder="https://" autocomplete="url" required />
          </div>
        </div>
        <div class="field">
          <label for={`${id}-category`}>Category you compete in</label>
          <input id={`${id}-category`} type="text" name="category" required />
          <span class="hint">However your buyers would describe it — "employment law in Dubai", "AI note-taking tools".</span>
        </div>
        <p><button class="btn" type="submit">Send me the report</button></p>
        <p class="hint">We use your details to run the report and get back to you. Nothing else, and we will not pass them on.</p>
      </form>
</section>
