---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import PromptRotator from '../components/PromptRotator.astro';
import { OFFERS, ENGINES, DELIVERABLES, NOT_SEO } from '../data/content';
import { SITE } from '../consts';

/* The page answers one question the home page raises and does not close:
   what actually happens, and what lands on your desk at the end of each part.
   Everything below is stated as an artefact — a file, a list, a document —
   rather than as activity, because activity is not checkable. */

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/service#service`,
  name: 'Answer engine optimisation',
  serviceType: 'Answer engine optimisation',
  description:
    'Answer surface measurement across five engines, diagnosis of the cause of absence, entity and content work, earned third-party placement, and monthly re-measurement against an untouched control set.',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  url: `${SITE.url}/service`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Engagements',
    itemListElement: OFFERS.map((o) => ({
      '@type': 'Offer',
      name: o.name,
      description: o.summary,
    })),
  },
};
---
<BaseLayout
  title="Service"
  description="What a Brandure engagement actually delivers: a frozen prompt set run across five answer engines, the cause of every absence diagnosed, the fix work itself, and monthly re-measurement against an untouched control set."
  schemas={[serviceSchema]}
>
  <!-- Hero: the promise and the constraint in the same breath. -->
  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap svc-hero">
      <div data-load>
        <h1 class="statement" data-split>Measure first. Then, and only then, do the work.</h1>
        <p class="lede">
          Without a baseline there is no way to show that anything done
          afterwards worked — and no honest way to charge for it. Every
          engagement starts with a measurement you could act on even if you
          never hired us.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#report">Get a free visibility report</a>
          <a class="btn btn--ghost" href="#stages">What you receive</a>
        </div>
      </div>
      <ul class="svc-facts" data-stagger>
        <li><span class="svc-facts__n">{ENGINES.length}</span> <span class="svc-facts__l">engines, measured and reported separately — never one blended score</span></li>
        <li><span class="svc-facts__n">2</span> <span class="svc-facts__l">weeks from frozen prompt set to a diagnosed cause per engine</span></li>
        <li><span class="svc-facts__n">1</span> <span class="svc-facts__l">control set, left deliberately untouched, so a change can be attributed</span></li>
      </ul>
    </div>
  </section>

  <!-- What it is not. The single most useful thing this page can do is draw
       the line against the thing buyers assume it is. -->
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>This is not an SEO retainer with a new name</h2>
        <p class="lede">
          The two overlap in places and we will happily work alongside your SEO
          team. But they are not the same job, and the differences decide what
          gets measured.
        </p>
      </div>

      <div class="compare" data-stagger>
        <div class="compare__head" aria-hidden="true">
          <span class="compare__t compare__t--axis">The difference</span>
          <span class="compare__t compare__t--seo">Search engine</span>
          <span class="compare__t compare__t--aeo">Answer engine<span class="compare__tag">what we work on</span></span>
        </div>
        {NOT_SEO.map((r, i) => (
          <div class="compare__row">
            <span class="compare__axis"><span class="compare__i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{r.axis}</span>
            <span class="compare__cell compare__cell--seo">
              <span class="compare__mob">Search engine</span>{r.seo}
            </span>
            <span class="compare__cell compare__cell--aeo">
              <span class="compare__mob">Answer engine</span>{r.aeo}
            </span>
          </div>
        ))}
        <p class="compare__foot">
          <strong>Both can be true at once.</strong> A page can rank first and
          still be absent from the answer above it, because the answer is built
          from what other sites say about you rather than from what you say
          about yourself.
        </p>
      </div>
    </div>
  </section>

  <!-- The prompt sets. Moved ahead of the deliverables: that section leans on
       "the frozen prompt set" four times, and this is where the phrase stops
       being jargon and becomes a thing on the screen. -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>What a frozen prompt set looks like</h2>
        <p class="lede">
          Yours is agreed with you and specific to your category. These are the
          shapes — the questions a buyer types when they are choosing, not when
          they are researching a topic.
        </p>
      </div>
      <PromptRotator />
    </div>
  </section>

  <!-- The four stages, as deliverables. -->
  <section class="section section--sunk" id="stages">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>What lands on your desk, stage by stage</h2>
        <p class="lede">
          The four stages of <a class="textlink" href="/method">SCAN</a>, stated
          as artefacts rather than activity. &ldquo;Entity work&rdquo; describes
          effort; a fix list with every change written out is a thing you can
          hold us to.
        </p>
      </div>

      <ol class="deliv">
        {DELIVERABLES.map((d, i) => (
          <li class:list={['deliv__item', `stages--${d.a}`]} style={`--i:${i}`}>
            <div class="deliv__rail" aria-hidden="true">
              <span class="deliv__n">{d.n}</span>
              <span class="deliv__line"></span>
            </div>
            <div class="deliv__body card">
              <div class="deliv__top">
                <div>
                  <p class="deliv__when">{d.when} &middot; {d.days}</p>
                  <h3 class="deliv__t">{d.stage} <span class="deliv__alias">&mdash; {d.alias}</span></h3>
                </div>
              </div>
              <p class="deliv__what">{d.what}</p>

              <p class="deliv__k">You receive</p>
              <ul class="deliv__list">
                {d.gets.map((g) => <li>{g}</li>)}
              </ul>

              <p class="deliv__honest"><strong>And plainly:</strong> {d.honest}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pricing. -->
  <section class="section" id="pricing">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Two ways in</h2>
        <p class="lede">The audit is the front door and stands on its own. Nothing obliges you to the retainer afterwards.</p>
      </div>
      <div class="price-grid" data-stagger>
        {OFFERS.map((o) => (
          <div class="card offer">
            <div class="offer__head">
              <h3>{o.name}</h3>
              <span class="offer__price">{o.price}</span>
              <span class="offer__unit">{o.unit}</span>
            </div>
            <div class="offer__body">
              <p>{o.summary}</p>
              <ul>{o.includes.map((i) => <li>{i}</li>)}</ul>
              <a class:list={['btn', !o.primary && 'btn--ghost']} href="#report">{o.cta}</a>
            </div>
          </div>
        ))}
      </div>
      <p class="center-row mt-2"><span class="note-sm"><span class="sample-flag">Sample pricing</span> &nbsp;Figures are placeholders for layout. Real pricing is set before launch.</span></p>
    </div>
  </section>

  <!-- The refusal. Kept as its own moment because it is the whole positioning. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="cta-card">
        <span class="cta-card__glint" aria-hidden="true"><span class="cta-card__sheen"></span></span>
        <div>
          <h2>We will tell you when the answer is no</h2>
          <p class="lede">
            If the baseline shows a category already settled on two incumbents
            with no visible route in, we say so and decline the work. A
            measurement that only ever produces a reason to hire us is not a
            measurement.
          </p>
        </div>
        <a class="btn cta-card__btn" href="#report">Start with the measurement</a>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="report">
    <div class="wrap">
      <div class="hero-grid">
        <div data-reveal>
          <h2 class="statement statement--sub" data-split>Find out where you stand.</h2>
          <p class="lede">
            Your category, run across all five engines. Who gets named, in
            what order, and which sources each answer was built from. You keep
            it whether or not anything follows.
          </p>
        </div>
        <ReportForm id="report-form" heading="Start with the free report" />
      </div>
    </div>
  </section>
</BaseLayout>
