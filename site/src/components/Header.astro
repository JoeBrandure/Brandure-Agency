---
import { NAV, SITE } from '../consts';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="wrap">
    <!-- Placeholder wordmark in the site's own typeface. A real mark drops
         into this reserved space without a layout change. -->
    <a class="wordmark" href="/" aria-label={`${SITE.name} — home`}>BRANDURE</a>
    <nav class="site-nav" aria-label="Primary">
      {NAV.map((i) => (
        <a href={i.href} aria-current={path === i.href || path.startsWith(`${i.href}/`) ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
  </div>
</header>
