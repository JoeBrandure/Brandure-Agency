---
/**
 * Runs before first paint, so the correct theme is applied without a flash.
 * Blocking and inline by necessity — deferring it is what causes the flash.
 * Reads a stored choice first, falls back to the OS preference.
 */
---
<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      var dark = stored ? stored === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    } catch (e) {
      document.documentElement.setAttribute('data-theme', 'light');
    }
    var root = document.documentElement;
    /* Automated browsers (rendering crawlers, screenshotting AI agents) keep
       `.no-js`: every entrance state is then released by the static styles
       from the first paint, before any motion code runs, so there is never a
       frame in which their content sits at opacity 0 or a count-up reads a
       partial figure. Same HTML, same DOM, same text — only the entrance
       animation is skipped, so this is not cloaking. Motion.astro and the
       /method tracker read the `data-automated` flag. A false positive costs
       a person nothing but an entrance animation. */
    var ua = navigator.userAgent || '';
    if (navigator.webdriver === true ||
        /bot\b|bot\/|crawler|spider|slurp|headless|gptbot|chatgpt|oai-searchbot|claude|anthropic|perplexity|googleother|google-inspectiontool|bingpreview|bytespider|ccbot|applebot|amazonbot|meta-externalagent|facebookexternalhit|duckassist|youbot|mistral|cohere|diffbot|petalbot|yandex/i.test(ua)) {
      root.setAttribute('data-automated', '');
      return;
    }
    /* `.no-js` IS NO LONGER REMOVED HERE, and that is the point.
       It used to come off before first paint, which armed every hidden
       entrance state immediately — so anything the observer then failed to
       reach stayed at opacity 0. A section heading rendered as an empty band
       until the 2.5s failsafe put the class back. Content was hidden by
       default and only revealed if JavaScript co-operated.
       Now Motion.astro removes it, at the moment it has an observer ready and
       has already settled whatever is on screen. Nothing is ever blank: if the
       motion runtime never loads, `.no-js` simply stays and every element
       keeps its final state. The failsafe is gone because there is no longer a
       window for it to cover. */
  })();
</script>
