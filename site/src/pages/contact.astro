---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Brandure about an answer surface audit, a sprint, or an ongoing AEO retainer."
>
  <h1>Contact</h1>

  <p class="lede">
    Tell us the category and the competitors you care about, and we will come
    back with what we can see.
  </p>

  <section class="gate" aria-labelledby="enquiry-heading">
    <h2 id="enquiry-heading">Send an enquiry</h2>

    <form
      name="enquiry"
      method="POST"
      action="/thanks"
      data-netlify="true"
      netlify-honeypot="bot-field"
    >
      <input type="hidden" name="form-name" value="enquiry" />

      <p class="hp">
        <label>
          Leave this field empty
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <p>
        <label for="enquiry-name">Name</label>
        <input id="enquiry-name" type="text" name="name" autocomplete="name" required />
      </p>

      <p>
        <label for="enquiry-email">Work email</label>
        <input id="enquiry-email" type="email" name="email" autocomplete="email" required />
      </p>

      <p>
        <label for="enquiry-company">Company</label>
        <input id="enquiry-company" type="text" name="company" autocomplete="organization" />
      </p>

      <p>
        <label for="enquiry-message">What are you trying to find out?</label>
        <textarea id="enquiry-message" name="message" required></textarea>
      </p>

      <p><button type="submit">Send enquiry</button></p>
    </form>
  </section>

  <p>
    Prefer email? <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>
</BaseLayout>
