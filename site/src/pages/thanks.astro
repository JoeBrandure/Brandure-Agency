---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thanks"
  description="Your report is ready to download."
  noindex
>
  <h1>Thanks — here is your report</h1>

  <p class="lede">
    We have your details. The report is linked below, and a copy is on its way
    to your inbox.
  </p>

  <p>
    <a href="/downloads/brandure-report.pdf" download>
      Download the report (PDF)
    </a>
  </p>

  <p class="note">
    Placeholder link. Replace <code>/downloads/brandure-report.pdf</code> with
    the real asset, or route per report using the <code>piece</code> field
    recorded on the submission.
  </p>

  <p>
    If it does not arrive, email <a href="mailto:hello@brandure.io">hello@brandure.io</a>
    and we will send it directly.
  </p>

  <p><a href="/research">Back to research</a></p>
</BaseLayout>
