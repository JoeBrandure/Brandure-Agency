---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('research')).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const anyReal = all.some((p) => !p.data.placeholder);
---
<BaseLayout
  title="Research"
  description="Original measurement of how AI answer engines treat specific categories and markets — which brands get named, which sources the answers are grounded on, and how much the engines disagree."
>
  <p class="eyebrow">Research</p>
  <h1>Published research</h1>

  <p class="lede">
    We publish what we measure, method attached, so any finding here can be
    checked or repeated rather than taken on trust.
  </p>

  {!anyReal && (
    <div class="note">
      <p><strong>No research published yet.</strong> The entries below are placeholder scaffolding showing the format. They carry no findings, and are excluded from search indexing, the sitemap and the feed until real pieces replace them.</p>
    </div>
  )}

  {all.length === 0 ? (
    <p>Nothing published yet.</p>
  ) : (
    <ul class="piece-list">
      {all.map((p) => (
        <li>
          <p class="meta">
            <time datetime={p.data.published.toISOString().slice(0, 10)}>{p.data.published.toISOString().slice(0, 10)}</time>
            <span class="tag">{p.data.vertical}</span>
            {p.data.placeholder && <span class="tag tag--draft">Placeholder</span>}
          </p>
          <h2><a href={`/research/${p.id}`}>{p.data.title}</a></h2>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
