---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { GUIDE_ORDER } from '../../data/guides';

/* Ordered by the reader's path through them, not by date — all three published
   on the same day, so a date sort would be arbitrary. GUIDE_ORDER is the one
   place that order is stated; llms.txt reads the same list. A guide missing
   from it fails the build rather than silently dropping off the index. */
const all = await getCollection('guides');
const guides = GUIDE_ORDER.map((slug) => {
  const g = all.find((x) => x.data.slug === slug);
  if (!g) throw new Error(`GUIDE_ORDER lists "${slug}", which no file in src/content/guides declares.`);
  return g;
});
if (guides.length !== all.length) {
  const missing = all.filter((g) => !GUIDE_ORDER.includes(g.data.slug as never)).map((g) => g.data.slug);
  throw new Error(`Guides not listed in GUIDE_ORDER, so they would not appear on /guides: ${missing.join(', ')}`);
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/guides#collection`,
  name: 'Guides',
  description: 'Practical guides to answer engine optimisation for UK and UAE businesses.',
  url: `${SITE.url}/guides`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  publisher: { '@id': `${SITE.url}/#organization` },
  /* Bare references to each guide's own Article node, which that guide's page
     defines. Derived from the same ordered list the cards render from, so the
     schema cannot list a guide the page does not show. */
  hasPart: guides.map((g) => ({ '@id': `${SITE.url}/guides/${g.data.slug}#article` })),
};
---
<BaseLayout
  title="Guides"
  description="Practical guides to answer engine optimisation for UK and UAE businesses: what AEO is, how to choose an agency, and how to check whether ChatGPT recommends you."
  schemas={[schema]}
>
  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap res-hero" data-load>
      <p class="eyebrow">Guides</p>
      <h1 class="statement" data-split>Guides</h1>
      <p class="lede">
        Practical guides to answer engine optimisation for UK and UAE businesses.
      </p>
    </div>
  </section>

  {/* The page was almost entirely cards: three links and one line of text,
      which is thin for a page meant to be the entry point to the subject.
      Existing prose styles, no new CSS. */}
  <section class="section">
    <div class="wrap-narrow" data-reveal>
      <div class="prose">
        <p>
          These guides explain how AI assistants like ChatGPT, Gemini,
          Perplexity, Claude, Copilot and Google&rsquo;s AI Overviews decide
          which businesses to recommend, and what a business can do about it.
        </p>
        <p>
          Each guide answers one practical question and draws on our own testing
          in Dubai, where we ran the same buying questions across several AI
          engines and recorded who they named and which sources they cited. The
          underlying data is on our <a href="/research">research pages</a>.
        </p>
        <p>
          Start with <a href="/guides/answer-engine-optimisation-uk-uae-guide">the
          overview</a> if you&rsquo;re new to AI search optimisation (AEO). If
          you want to know where you stand today,
          <a href="/guides/check-whether-chatgpt-recommends-your-business">the
          ChatGPT check</a> takes about an hour and needs no paid tools.
        </p>
      </div>
    </div>
  </section>

  {/* Same card list as /research — one per row, title and summary carrying the
      weight. Reused rather than restyled. */}
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <ol class="rlist" data-stagger>
        {guides.map((g, i) => (
          <li class="rlist__i">
            <a class="rcard" href={`/guides/${g.data.slug}`}>
              <span class="rcard__i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

              <div class="rcard__body">
                <h2 class="rcard__t">{g.data.title}</h2>
                <p class="rcard__d">{g.data.meta_description}</p>

                <p class="rcard__go">
                  Read the guide
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 12h15M13 6l6 6-6 6"/>
                  </svg>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <p class="center-row mt-2"><a class="textlink" href="/research">Our published research &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
