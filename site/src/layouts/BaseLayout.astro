---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ThemeScript from '../components/ThemeScript.astro';
import Motion from '../components/Motion.astro';
import FormEnhance from '../components/FormEnhance.astro';
import { SITE } from '../consts';
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks, generated from page content by the caller. */
  schemas?: object[];
  /** Path to the generated OG image for this page. */
  ogImage?: string;
}

const { title, description, noindex = false, schemas = [], ogImage } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site ?? SITE.url);
const pageTitle = title === SITE.name ? `${SITE.name} — answer engine optimisation` : `${title} — ${SITE.name}`;
const image = new URL(ogImage ?? '/og/default.png', SITE.url);

/* Site-level identity, on every page. */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'en-GB',
  publisher: { '@id': `${SITE.url}/#organization` },
};
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  email: SITE.email,
  description: SITE.description,
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  sameAs: [SITE.linkedin],
  contactPoint: [{
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: SITE.email,
    availableLanguage: ['en'],
  }],
};
const allSchemas = [websiteSchema, organizationSchema, ...schemas];
---

<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} research`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <Analytics />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <Motion />
    <FormEnhance />
  </body>
</html>
