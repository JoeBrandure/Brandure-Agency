---
import BaseLayout from '../layouts/BaseLayout.astro';
import CurrencySwitch from '../components/CurrencySwitch.astro';
import PlanCards from '../components/PlanCards.astro';
import StatsBand from '../components/StatsBand.astro';
import Price from '../components/Price.astro';
import { SITE } from '../consts';
/* PLANS and `money` went with the removed schema node: the visible plan
   cards render from PlanCards, which imports PLANS itself. */
import { SETUP_FEE, ADDONS, TERM_AND_EXIT } from '../data/pricing';
import { TESTIMONIALS } from '../data/testimonials';
/* The shared Service node: one definition, emitted here as on / and
   /pricing, pointing at the one priced catalog on /pricing. */
import { serviceSchema } from '../lib/schema';

/* AEO AGENCY DUBAI — a local landing page for "AEO agency Dubai".
 *
 * Same shape as /ai-ready-websites: hero, prose sections, prices, FAQs. Copy
 * as approved; this file decides structure only.
 *
 * DEFAULTS TO AED. Every other page takes its currency from the edge function
 * or a stored choice. This one is read by people searching for a Dubai agency,
 * so it asks for AED up front — but the switch is still here, and a visitor
 * who has already chosen pounds keeps pounds. The default is a default, not an
 * override.
 *
 * Prices render from src/data/pricing.ts, so this page cannot quote a figure
 * /pricing does not.
 */
const url = `${SITE.url}/aeo-agency-dubai`;
const page = ADDONS.find((a) => a.key === 'page')!;
const tom = TESTIMONIALS.find((t) => t.brand === 'Lurio')!;

const FAQS = [
  {
    q: 'How much does an AEO agency cost in Dubai?',
    a: "Most Dubai businesses pay between AED 5,000 and AED 20,000 a month, depending on how many services and questions are tracked. Brandure's plans are AED 6,500 or AED 12,000 a month, plus a one-off AED 3,500 setup, excluding VAT.",
  },
  {
    q: 'How long does AEO take to work in Dubai?',
    a: 'Technical and Google Business Profile fixes can show within weeks. Earned citations usually take two to three months to show consistently across the engines.',
  },
  {
    q: 'Is AEO different from SEO?',
    a: 'SEO gets you ranked on Google. AEO gets you named inside AI answers. Most of the groundwork overlaps, so every Brandure plan includes both.',
  },
  {
    q: 'Do you work with businesses outside Dubai?',
    a: 'Yes. We work across the UAE and the UK, with Dubai as our base.',
  },
  {
    /* Was "Jumeirah Village Circle (JVC), Dubai, with a second office in the
       UK." Brandure keeps no premises in either market, so the honest answer
       is how the work runs, not where a desk is. Self-contained, like every
       answer here, because an engine quotes one at a time. */
    q: 'Do you need to be in Dubai to work with Brandure?',
    a: 'No. Brandure is a remote agency working across the UAE and the UK. Tracking, citations, SEO and website work are all done remotely, and calls are on phone or video.',
  },
];

/* The page's own sentence, written once. The meta tag and the WebPage node
   carried identical copies, so trimming the meta description for the SERP
   would have left the schema describing the page in words the page no longer
   used. Trimmed to 155 characters with the answer still first. */
const pageDescription =
  'Brandure is an AEO agency in Dubai, getting businesses named in ChatGPT, Google AI Overviews and Perplexity. SEO and AI-ready websites included.';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#webpage`,
  url,
  name: 'AEO agency in Dubai',
  description: pageDescription,
  inLanguage: 'en-GB',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#service` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${url}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'AEO agency in Dubai', item: url },
  ],
};

/* NO ProfessionalService NODE, AND NO LocalBusiness ANYWHERE ON THE SITE.
 *
 * This page carried one at #dubai-office. It existed to be the Dubai entity:
 * its own address, phone, area served and an AED-only price list hanging off
 * it. The address came off on 2026-11-19, when the site stopped claiming
 * premises it does not have, and what was left was a LocalBusiness subtype —
 * a type whose whole meaning is a place you can visit — describing an agency
 * that works remotely. It could not earn a local rich result without an
 * address, so it was asserting something untrue for nothing in return.
 *
 * The node is gone. Nothing referenced it: #dubai-office, #catalog-aed and
 * the three aeo-agency-dubai#offer-* ids it owned were defined here and
 * pointed at from nowhere else, so there was no reference to repoint at
 * #organization. The AED figures are unaffected — /pricing#catalog carries
 * every plan with an AED UnitPriceSpecification beside GBP and USD, and the
 * Service node this page emits already points at that catalog.
 *
 * What the page still emits: WebPage, BreadcrumbList, Service, FAQPage.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="AEO Agency in Dubai | AI Search & SEO | Brandure"
  fullTitle
  description={pageDescription}
  schemas={[webPageSchema, breadcrumbSchema, serviceSchema, faqSchema]}
>
  <script is:inline>
    /* AED is this page's default. A visitor who has already picked pounds
       keeps pounds — a default must not overrule a choice.

       IT HAS TO RUN BEFORE CurrencySwitch. Sitting at the end of the body, it
       did not: the switch had already read an unset data-cur, fallen back to
       pounds and pressed the £ button, and this script then moved the prices
       to AED underneath it. The page showed AED figures beside a control
       saying £ was selected. Here it runs first, so the switch reads 'aed'
       and marks the right button — one source of truth for that state, which
       is the switch's own. */
    (function () {
      var root = document.documentElement;
      var stored = null;
      try { stored = localStorage.getItem('brandure_cur'); } catch (e) { /* no choice stored */ }
      /* Every stored choice is honoured, 'usd' included. The test used to
         name only 'aed' and 'gbp', so a visitor who had explicitly chosen
         dollars was pushed back to dirhams on this page alone. A default
         must not overrule a choice. Matches /aeo-agency-uk. */
      if (stored !== 'aed' && stored !== 'gbp' && stored !== 'usd') {
        root.setAttribute('data-cur', 'aed');
      }
    })();
  </script>

  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap-narrow" data-load>
      <p class="eyebrow">Dubai</p>
      <h1 class="statement statement--sub" data-split>AEO agency in Dubai</h1>
      <p class="lede">
        Brandure is an AI search optimisation (AEO) and SEO agency working
        with Dubai businesses. We get you named when buyers ask ChatGPT,
        Google AI Overviews and Perplexity who to use, and ranked on Google
        for the same questions.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/#report">Get your free AI visibility report</a>
        <a class="btn btn--violet" href="/pricing">Build your plan</a>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap-narrow" data-reveal>
      <div class="prose">
        <h2>Why AI search works differently in Dubai</h2>
        <p>
          We research how AI engines answer questions about Dubai businesses,
          and the engines don&rsquo;t agree. Each one often names different
          businesses for the same question. ChatGPT and Perplexity lean on
          directories, ranked lists and press, and Google AI Overviews draws
          from its own eligible pool and rotates which source it credits. So a
          Dubai business can be recommended by one engine and missing from the
          rest.
        </p>
        <p>
          That&rsquo;s why we track and report each engine separately, and why
          most of the work happens on the sites the engines read, not only on
          yours.
        </p>
        <p><a href="/research">Read our Dubai research &rarr;</a></p>

        <h2>What we do for Dubai businesses</h2>
        <ul>
          <li><strong>AI visibility tracking per engine.</strong> We track the questions your Dubai buyers actually ask, across ChatGPT, Google AI Overviews and Perplexity, reported separately every month.</li>
          <li><strong>Earned citations.</strong> We get you placed on the Dubai directories, ranked lists and publications the engines quote.</li>
          <li><strong>SEO included.</strong> Technical SEO at setup and ongoing SEO for your priority pages, so you rank on Google as well.</li>
          <li><strong>Google Business Profile and entity fixes.</strong> Your name, category and location stay consistent everywhere AI looks, which matters for Google AI Overviews.</li>
          <li><strong>AI-ready websites.</strong> When your site is the blocker, we rebuild the pages that matter on your current platform. <a href="/ai-ready-websites">How we build</a>.</li>
        </ul>
      </div>
    </div>
  </section>

  {/* Results: the market band and the client's own words. The "92% more AI
      answer appearances / Lurio" card is gone — an unsourced client
      percentage is exactly what this agency argues against, and the band in
      its place carries figures a reader can open and check. The quote
      stays. */}
  <section class="section" aria-labelledby="res-h">
    <div class="wrap" data-reveal>
      <StatsBand as="h2" id="res-h" ctaHref="/#report" />
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap-narrow" data-reveal>
      <ul class="tst__col dub-quote" role="list">
        <li class:list={['tst__card', `tst--${tom.accent}`]}>
          <blockquote>
            <p>{tom.quote}</p>
            <footer>
              <span class="tst__mono" aria-hidden="true">{tom.initials}</span>
              <span class="tst__who">
                <cite>{tom.name}</cite>
                <span class="tst__role">{tom.role} &middot; {tom.brand}</span>
              </span>
            </footer>
          </blockquote>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="pr-h">
    <div class="wrap-narrow" data-reveal>
      <div class="section-head">
        <h2 id="pr-h">Prices in Dubai</h2>
      </div>
      <CurrencySwitch />

      {/* THE SAME TWO CARDS AS /pricing, display-only. A bullet list of
          figures reads as fine print on the page a buyer lands on from
          "AEO agency Dubai" — the cards are what they will see when they get
          to /pricing, so showing them here makes the two pages one journey
          rather than two quotes. .pcard lives in global.css for exactly this
          reason; the markup is an <a> instead of a <label> because there is
          nothing to choose on this page.

          Every figure comes from data/pricing.ts, so this cannot drift from
          the builder. */}
      <div class="grid grid--2 dub-plans">
        <PlanCards mode="link" />
      </div>

      <div class="prose">
        {/* Astro collapses the newline between a close tag and the text on the
            next line, which is how "a month." and "One category" ran together
            in the list this replaced. Every space that has to survive is
            written inside the text, never left to the indentation. */}
        <p class="note-sm dub-plus">
          <strong>{SETUP_FEE.name} <Price m={SETUP_FEE.price} /> one-off</strong>, included with every plan
          &middot; <strong>Website work</strong> from <Price m={page.price} /> per page
        </p>
        <p class="note-sm">
          Prices exclude 5% VAT. {TERM_AND_EXIT}
        </p>
        <p>
          <a class="btn" href="/pricing">Build your plan</a>
        </p>
        <p>
          <a href="/guides/aeo-cost-uae">How much AEO costs in the UAE &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow" data-reveal>
      <div class="prose">
        <h2>How it works</h2>
        <ol>
          <li><strong>Free AI visibility report.</strong> See how each engine answers your buyers&rsquo; questions today, and who it names instead of you.</li>
          <li><strong>Setup in 10 working days.</strong> Technical SEO, schema, AI crawler access, Google Business Profile and your baseline.</li>
          <li><strong>Monthly work and reporting.</strong> Citations, content and SEO, with AI visibility, rankings and AI-referred traffic reported per engine.</li>
        </ol>

        <h2>Talk to us</h2>
        {/* No address. We work with Dubai businesses remotely, and a
            landing page is the last place to imply premises. */}
        <p>
          We work with Dubai businesses remotely, so everything runs over
          phone, email and video.<br />
          Phone: <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a><br />
          Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
        <p><a class="btn" href="/services#book">Book a call</a></p>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap-narrow" data-reveal>
      <div class="section-head">
        <h2>Questions</h2>
      </div>
      <div class="qa">
        {FAQS.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Reuses .case and .tst__card wholesale; these only place them on a page
     that has one of each rather than a grid. */
  /* ONE WIDTH, BOTH CENTRED. The result card ran the full column while the
     quote under it was capped at 34rem and left-aligned, so the pair read as
     two unrelated blocks rather than a result and the client who got it. */
  .dub-case,
  .dub-quote { max-width: 34rem; margin-inline: auto; }
  .dub-case { margin-bottom: 1.5rem; }
  .dub-quote { list-style: none; padding: 0; }
  /* The cards sit between the currency switch and the prose, so they need the
     gap the prose would otherwise have given them. The "Most chosen" tag
     overhangs the card's top edge, hence the row of top padding. */
  .dub-plans { margin: 0 0 1.5rem; padding-top: 0.65rem; }
  .dub-plus { margin-top: 0; }
</style>
