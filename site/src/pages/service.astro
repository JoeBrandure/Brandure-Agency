---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import { PACKAGES, ENGINES, COST_OF_ABSENCE, NOT_SEO } from '../data/content';
import { SCAN } from '../data/method';
import { SITE } from '../consts';

/* SERVICE IS THE COMMERCIAL PAGE. What we sell, why it exists, and why this
   buyer needs it now. It shows SCAN and refuses to explain it.

   Until 2026-08-27 this page walked all four stages in as much detail as
   /method did — same four headings, same artefacts, same arguments — so the
   two pages said the same thing twice and neither owned it. The split now:

     /service  organised by what you buy   → packages, artefacts, price
     /method   organised by how it runs    → SCAN in full, the instruments

   The four-letter strip below is the only SCAN content on this page and it
   links out rather than expanding. Anything explaining *how* a stage works
   belongs on /method; anything describing what lands on a desk belongs here. */

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/service#service`,
  name: 'Answer engine optimisation',
  serviceType: 'Answer engine optimisation',
  description:
    'Answer engine visibility measured across ChatGPT, Claude, Perplexity, Gemini and Google, the cause of every absence diagnosed, the entity, content and earned-placement work that follows, and a monthly net figure separating what the work moved from what the market moved.',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  url: `${SITE.url}/service`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Engagements',
    itemListElement: PACKAGES.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      description: p.lede,
    })),
  },
};
---
<BaseLayout
  title="Service"
  description="What we sell and what it costs. A one-off audit that shows you where you stand across five AI engines and why, and a monthly retainer that does the work and shows you how much of the change was us."
  schemas={[serviceSchema]}
>
  <!-- 1. Hero: the offer and the constraint in the same breath. -->
  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap svc-hero">
      <div data-load>
        <h1 class="statement" data-split>Find out where you stand before you spend anything fixing it.</h1>
        <p class="lede">
          Every engagement starts with a measurement of your category across all
          five AI engines. You will see who is getting named instead of you and
          why. It is useful on its own, and it is yours to keep whether you go
          any further with us or not.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#report">Get a free visibility report</a>
          <a class="btn btn--ghost" href="#buy">What you buy</a>
        </div>
      </div>
      <ul class="svc-facts" data-stagger>
        <li><span class="svc-facts__n">{ENGINES.length}</span> <span class="svc-facts__l">engines, measured and reported separately — never one blended score</span></li>
        <li><span class="svc-facts__n">2</span> <span class="svc-facts__l">weeks from agreeing the questions to knowing why you are missing</span></li>
        <li><span class="svc-facts__n">1</span> <span class="svc-facts__l">net figure a month, with your category’s own movement taken out</span></li>
      </ul>
    </div>
  </section>

  <!-- 2. Why this buyer needs it. The commercial consequence of absence, which
       is a different argument from the home page's "why you are absent". -->
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>The leads you are losing here never show up anywhere</h2>
        <p class="lede">
          Three reasons this one behaves differently from every other channel
          you report on.
        </p>
      </div>

      <div class="problem-grid problem-grid--3" data-stagger>
        {COST_OF_ABSENCE.map((c) => (
          <div class:list={['card', 'problem', `problem--${c.a}`]}>
            <span class="problem__n" aria-hidden="true">{c.n}</span>
            <h3>{c.t}</h3>
            <p class="problem__p">{c.p}</p>
            <div class="problem__effect">
              <span class="problem__k">Why it matters</span>
              <p>{c.e}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. What it is not. The line against the thing buyers assume it is. -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>This is not an SEO retainer with a new name</h2>
        <p class="lede">
          There is real overlap, and we are happy to work alongside whoever
          handles your SEO. They are still two different jobs, and the
          differences change what you should be measuring.
        </p>
      </div>

      <div class="compare" data-stagger>
        <div class="compare__head" aria-hidden="true">
          <span class="compare__t compare__t--axis">The difference</span>
          <span class="compare__t compare__t--seo">Search engine</span>
          <span class="compare__t compare__t--aeo">Answer engine<span class="compare__tag">what we work on</span></span>
        </div>
        {NOT_SEO.map((r, i) => (
          <div class="compare__row">
            <span class="compare__axis"><span class="compare__i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{r.axis}</span>
            <span class="compare__cell compare__cell--seo">
              <span class="compare__mob">Search engine</span>{r.seo}
            </span>
            <span class="compare__cell compare__cell--aeo">
              <span class="compare__mob">Answer engine</span>{r.aeo}
            </span>
          </div>
        ))}
        <p class="compare__foot">
          <strong>Both of these can be true on the same day.</strong> You can
          rank first on Google and be missing from the AI answer sitting above
          it, because that answer was built from what other sites say about
          you rather than what you say about yourself.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. SCAN, shown and not explained. Four letters, one line each, and a way
       out to the page that owns the detail. -->
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Every engagement runs the same four stages</h2>
        <p class="lede">
          We call it SCAN. You get the same four in the same order whether you
          buy the audit or the retainer, and the fourth one is what lets you
          check the other three actually worked.
        </p>
      </div>

      <ol class="scan-strip" data-stagger>
        {SCAN.map((s) => (
          <li class:list={['scan-strip__i', `stages--${s.a}`]}>
            <span class="scan-strip__k" aria-hidden="true">{s.k}</span>
            <h3 class="scan-strip__t">{s.name}</h3>
            <p class="scan-strip__d">{s.d}</p>
          </li>
        ))}
      </ol>

      <p class="center-row mt-2">
        <a class="btn btn--ghost" href="/method">How each stage works &rarr;</a>
      </p>
    </div>
  </section>

  <!-- 5. What you buy. Artefacts attached to a purchase, with the price on the
       same card, because "what you get" and "what it costs" are one question. -->
  <section class="section" id="buy">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Two ways in</h2>
        <p class="lede">
          Most people start with the audit. Nothing about it commits you to the
          retainer afterwards.
        </p>
      </div>

      <div class="pkg" data-stagger>
        {PACKAGES.map((p) => (
          <article class:list={['pkg__c', `stages--${p.a}`]}>
            <div class="pkg__head">
              <p class="pkg__covers">
                <span class="pkg__letters" aria-hidden="true">
                  {SCAN.map((s) => (
                    <span class:list={['pkg__l', p.covers.includes(s.k) && 'is-on', `stages--${s.a}`]}>{s.k}</span>
                  ))}
                </span>
                <span class="pkg__coversl">{p.coversLabel}</span>
              </p>
              <h3 class="pkg__n">{p.name}</h3>
              <p class="pkg__lede">{p.lede}</p>
              <p class="pkg__price"><span class="pkg__pn">{p.price}</span> <span class="pkg__pu">{p.unit}</span></p>
            </div>

            <div class="pkg__body">
              <p class="pkg__s">{p.summary}</p>

              <p class="pkg__k">What lands on your desk</p>
              <ul class="pkg__gets">
                {p.gets.map((g) => <li>{g}</li>)}
              </ul>

              <p class="pkg__honest"><strong>And plainly:</strong> {p.honest}</p>
              <a class:list={['btn', !p.primary && 'btn--ghost', 'pkg__cta']} href="#report">{p.cta}</a>
            </div>
          </article>
        ))}
      </div>

      <p class="center-row mt-2">
        <span class="note-sm"><span class="sample-flag">Sample pricing</span> &nbsp;Figures are placeholders for layout. Real pricing is set before launch.</span>
      </p>
    </div>
  </section>

  <!-- 6. The refusal. Kept as its own moment because it is the whole positioning. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="cta-card">
        <span class="cta-card__glint" aria-hidden="true"><span class="cta-card__sheen"></span></span>
        <div>
          <h2>Sometimes the honest answer is “do not bother yet”</h2>
          <p class="lede">
            If the first measurement shows your category sewn up by two
            competitors with no way in, we will tell you and turn the work
            down. You would be right to be suspicious of an agency whose
            research always concludes that you should hire them.
          </p>
        </div>
        <a class="btn cta-card__btn" href="#report">Start with the measurement</a>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="report">
    <div class="wrap">
      <div class="hero-grid">
        <div data-reveal>
          <h2 class="statement statement--sub" data-split>See what the AI says about you.</h2>
          <p class="lede">
            We run your category across all five engines and send you what comes
            back: who gets named, in what order, and which sources each answer
            was built from. No charge, and nobody will chase you afterwards.
          </p>
        </div>
        <ReportForm id="report-form" heading="Start with the free report" />
      </div>
    </div>
  </section>
</BaseLayout>
