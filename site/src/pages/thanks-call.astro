---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';

/* Where the booking form lands. See the note at the top of thanks.astro for
   why a static site cannot show a success state on the form's own URL.

   SITE.bookingUrl is a build-time constant, not a query string, so branching
   on it here is safe: fill it in and the calendar button ships on the next
   deploy. While it is null this page promises times by email instead, which
   is what the form itself says will happen. */
---
<BaseLayout
  title="Thanks"
  description="Your call request is in. Pick a time, or we'll come back to you with some."
  noindex={true}
>
  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap res-hero" data-load>
      <p class="eyebrow">Request received</p>
      <h1 class="statement" data-split>
        {SITE.bookingUrl ? 'Got it. Now pick a time.' : 'Got it. Times are on their way.'}
      </h1>
      <p class="lede">
        {SITE.bookingUrl
          ? 'Fifteen minutes, and your category will be open in front of us before we start. Nothing to prepare.'
          : 'We’ll come back to you with times, usually within one working day, and your category will be open in front of us before we start. Nothing to prepare.'}
      </p>
      <div class="hero-actions">
        {SITE.bookingUrl && (
          <a class="btn" href={SITE.bookingUrl} target="_blank" rel="noopener">Pick a time &rarr;</a>
        )}
        <a class:list={['btn', SITE.bookingUrl && 'btn--ghost']} href="/method">See how we measure it</a>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>What the call covers</h2>
        <p class="lede">
          No deck, and no discovery questions we could have answered ourselves
          from what you just sent.
        </p>
      </div>

      <div class="problem-grid problem-grid--3" data-stagger>
        <div class="card problem problem--cobalt">
          <span class="problem__n" aria-hidden="true">01</span>
          <h3>Where you stand today</h3>
          <p class="problem__p">
            What the six engines return for your category right now, and who is
            getting named instead of you.
          </p>
        </div>
        <div class="card problem problem--violet">
          <span class="problem__n" aria-hidden="true">02</span>
          <h3>Which of the three causes applies</h3>
          <p class="problem__p">
            Whether an engine can&rsquo;t identify you, can&rsquo;t find
            anything about you, or simply prefers someone else. Each needs
            different work.
          </p>
        </div>
        <div class="card problem problem--teal">
          <span class="problem__n" aria-hidden="true">03</span>
          <h3>Whether we&rsquo;re the right fit</h3>
          <p class="problem__p">
            Including the version where we tell you your category isn&rsquo;t
            being bought through AI Search yet and you shouldn&rsquo;t spend on
            this.
          </p>
        </div>
      </div>

      <p class="center-row mt-2">
        <span class="note-sm">
          Need to change something you sent? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </span>
      </p>
    </div>
  </section>
</BaseLayout>
