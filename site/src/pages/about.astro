---
/**
 * STUB — created 2026-09-24 because the research series links here from every
 * byline, every author bio and the Person JSON-LD in the Article schema, and a
 * link that 404s in structured data is worse than a thin page.
 *
 * What is here is Joe's bio as it already appears at the foot of the research
 * drafts, and nothing invented. It needs a proper write-up: what Brandure is,
 * why it exists, and a photograph.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

/* The Person node for @id https://brandure.io/about#person used to be defined
   here. It now lives in BaseLayout and is emitted sitewide, so this page gets
   it like every other page. Re-adding it here would resolve that @id to two
   full nodes, which is the duplication this consolidation removed. */
---
<BaseLayout
  title="About Brandure: AI search optimisation (AEO) agency, UAE & UK"
  fullTitle
  description="Brandure is an answer engine optimisation agency in the UAE and UK, helping businesses get named in ChatGPT, Google AI Overviews and Perplexity."
>
  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap res-hero" data-load>
      <p class="eyebrow">About</p>
      <h1 class="statement" data-split>About Brandure</h1>
      <p class="lede">
        Brandure is an answer engine optimisation (AEO) agency operating in the
        UAE and UK.
      </p>
    </div>
  </section>

  {/* ANSWER FIRST. The page opened on "Joe Hickman", so the first thing an
      engine read on the page named to answer "what is Brandure" was a
      person — which is what Searchable marked Critical. The founder section
      is unchanged and follows this. */}
  <section class="section">
    <div class="wrap-narrow" data-reveal>
      <div class="prose">
        <p>
          Brandure is an answer engine optimisation (AEO) agency operating in
          the UAE and UK. It helps businesses get named and cited in the
          answers ChatGPT, Google AI Overviews and Perplexity give their
          buyers. Every engagement starts by measuring where a business stands
          across those three engines, then fixes the causes: website
          foundations, entity data, answer-ready content and the third-party
          sources the engines cite. See <a href="/method">how we work</a> and{' '}
          <a href="/research">our research</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap-narrow" data-reveal>
      <div class="prose">
        <h2>Joe Hickman</h2>
        <p>
          Joe Hickman is the founder of Brandure, an answer engine optimisation
          agency operating in the UAE and UK: how businesses get named in
          ChatGPT, Google&rsquo;s AI Overviews and Perplexity.
        </p>
        <p>
          He has a background in paid social across Meta, Google, TikTok and
          LinkedIn.
        </p>
        <p>
          Brandure publishes its own measurement rather than citing other people&rsquo;s.{' '}
          <a href="/research">The research index</a> carries the questions asked, the
          market, the engines and the run count behind every figure.
        </p>
      </div>

      <p class="center-row mt-2">
        <a class="btn" href="/#report">Get a free visibility report</a>
      </p>
    </div>
  </section>
</BaseLayout>
