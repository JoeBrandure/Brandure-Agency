---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ThemeScript from '../components/ThemeScript.astro';
import Motion from '../components/Motion.astro';
import FormEnhance from '../components/FormEnhance.astro';
import { SITE } from '../consts';
import '@fontsource-variable/inter';
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  /** Use `title` verbatim as the <title>, with no " — Brandure" suffix. For a
   *  page whose title is written as a complete SERP line in its own right. */
  fullTitle?: boolean;
  description: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks, generated from page content by the caller. */
  schemas?: object[];
  /** Path to the generated OG image for this page. */
  ogImage?: string;
}

const { title, description, noindex = false, schemas = [], ogImage, fullTitle = false } = Astro.props;

/* With `build.format: 'file'`, Astro.url.pathname is the OUTPUT FILE PATH —
   /index.html, /research/foo.html — not the route Netlify serves. This was
   built straight from it, so every page declared a canonical and an og:url
   ending in .html while the sitemap, llms.txt and every internal link used the
   extensionless form. Both forms return 200, so each page was reachable at two
   URLs and the canonical pointed at the one nothing else referenced.
   Map the file path back to the served route. The order matters: strip .html
   first, then collapse a directory index to its folder, then drop a trailing
   slash from everything except the root. That also keeps this correct if
   build.format ever moves to 'directory', where pathname arrives as /foo/. */
const route =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '/')
    .replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(route, Astro.site ?? SITE.url);
const pageTitle = fullTitle
  ? title
  : title === SITE.name
    ? `${SITE.name} — answer engine optimisation`
    : `${title} — ${SITE.name}`;
const image = new URL(ogImage ?? '/og/default.png', SITE.url);

/* Site-level identity, on every page. */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'en-GB',
  publisher: { '@id': `${SITE.url}/#organization` },
};
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  email: SITE.email,
  description: SITE.description,
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  sameAs: [SITE.linkedin],
  founder: { '@id': `${SITE.url}/about#person` },
  contactPoint: [{
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: SITE.email,
    availableLanguage: ['en'],
  }],
};
/* The canonical Person node, emitted sitewide for the same reason
   #organization is: the research Articles reference it by @id, and a reference
   to a node that is only defined on /about asks a consumer to have already
   crawled /about for the author of a page it is reading now. Defined here and
   nowhere else — /about must not emit its own copy, or the @id resolves to two
   full nodes instead of one. */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/about#person`,
  name: 'Joe Hickman',
  jobTitle: 'Founder',
  url: `${SITE.url}/about`,
  worksFor: { '@id': `${SITE.url}/#organization` },
  knowsAbout: [
    'Answer engine optimisation',
    'Generative engine optimisation',
    'Search engine optimisation',
    'Paid social',
  ],
};
const allSchemas = [websiteSchema, organizationSchema, personSchema, ...schemas];
---

<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {/* .ico first, SVG second: browsers that understand the SVG take it on the
        type attribute, and the ones that don't stop at the first icon they can
        parse. /favicon.ico was 404ing — some crawlers and feed readers request
        it at the root regardless of what is declared here. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} research`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <Analytics />

    {/* Searchable — referrals from AI answer surfaces. Separate from the
        Netlify edge function, which counts AI crawlers rather than people:
        this half only sees a visitor who clicked through from ChatGPT,
        Perplexity and the like. The site token is public by design.

        is:inline on both, matching the PostHog snippet. Without it Astro
        bundles the stub and rewrites the src on the loader, and the queue the
        first tag defines is the thing the second one drains. */}
    <script is:inline>window.sa=window.sa||function(){(sa.q=sa.q||[]).push(arguments)}</script>
    <script
      is:inline
      defer
      src="https://tracker.searchableanalytics.com/s.js"
      data-domain="brandure.io"
      data-site-token="pst_af562e72612f1d69ee10023f"
    ></script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <Motion />
    <FormEnhance />
  </body>
</html>
