---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import PromptRotator from '../components/PromptRotator.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import { SITE } from '../consts';
import { FAQS, FAQS_HOME, HERO_MODE, HERO_STATS, HERO_CASES, PROBLEMS, STAGES, PACKAGES, ENGINES, PRIZE } from '../data/content';
import { getCollection } from 'astro:content';
import { readdirSync } from 'node:fs';

/* Same lookup the strip uses: match a file in public/logos/ by slug. */
let logoFiles: string[] = [];
try { logoFiles = readdirSync('./public/logos'); } catch { logoFiles = []; }
/* Each card carries the mark twice — one file for the light theme, one for
   the dark — because no single version of these four works on both. Lurio and
   Viveonix ship as white-knockout artwork and need dark-ink variants on a
   light card; Little Lockets and Fresh Gym are dark artwork and need lightened
   variants on a dark one. CSS shows one and hides the other.
   Naming: `<slug>-light.*` and `<slug>-dark.*`, falling back to `<slug>.*`.
   How each variant was derived is in public/logos/README.md. */
const byName = (n: string) => logoFiles.find((f) => f.replace(/\.[^.]+$/, '') === n);
const caseCards = HERO_CASES.map((c) => ({
  ...c,
  light: byName(`${c.slug}-light`) ?? byName(c.slug),
  dark: byName(`${c.slug}-dark`) ?? byName(c.slug),
}));

const pieces = (await getCollection('research'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/#service`,
  name: 'Answer engine optimisation',
  serviceType: 'Answer engine optimisation',
  description: SITE.description,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  url: `${SITE.url}/service`,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  /* Only the questions actually present on this page. The full set is
     marked up on /faq. */
  mainEntity: FAQS_HOME.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---

<BaseLayout
  title={SITE.name}
  description="We show you where your brand stands inside AI answers on ChatGPT, Claude, Perplexity, Gemini and Google, then do the work to get you named. Start with a free visibility report."
  schemas={[serviceSchema, faqSchema]}
>
  <!-- 1. Hero — statement left, real measured figures right -->
  <section class="hero">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
      <div class="mesh__layer mesh__layer--3"><div class="mesh__blob mesh__blob--3"></div></div>
    </div>
    <div class="wrap hero-grid">
      <div data-load>
        <h1 class="statement" data-split>Turning AI Search from a blind spot into a revenue channel.</h1>
        <p class="lede">
          Five engines, measured separately every month; so you can see exactly
          what we moved and what your market moved on its own.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#report">Show me where I stand</a>
          <a class="btn btn--violet" href="/service">See what we do</a>
        </div>
      </div>

      <div>
        {HERO_MODE === 'stats' ? (
          <>
            <div class="metric-grid" data-stagger>
              {HERO_STATS.map((st) => (
                <div class="metric">
                  <span class="metric__chip">{st.chip}</span>
                  <span class="metric__n">
                    <span data-count={st.n}>{st.n}</span>{st.suffix && <span class="metric__suffix">{st.suffix}</span>}
                  </span>
                  <p class="metric__l">{st.label}</p>
                </div>
              ))}
            </div>
            <p class="figure__src mt-1">
              First three: Pew Research Center, 22 July 2025 — 68,879 Google
              searches by 900+ US adults, March 2025. Google AI Overviews
              specifically, not AI answers in general. The 47% is derived from
              that study’s own 15% and 8%.
            </p>
          </>
        ) : (
          <div class="case-grid" data-stagger>
            {caseCards.map((c) => (
              <figure class="case">
                <span class="case__mark" style={`--optical:${c.optical}`}>
                  {c.light ? (
                    <>
                      <img class="on-light" src={`/logos/${c.light}`} alt={c.brand} decoding="async" />
                      <img class="on-dark" src={`/logos/${c.dark}`} alt="" aria-hidden="true" decoding="async" loading="lazy" />
                    </>
                  ) : (
                    <span class="case__wordmark">{c.brand}</span>
                  )}
                </span>
                <figcaption>
                  <span class="case__n">
                    <span data-count={c.metric}>{c.metric}</span><span class="case__suffix">{c.suffix}</span>
                  </span>
                  <span class="case__l">{c.label}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 2. Logo strip — inverted band, pill label -->
  <LogoStrip />

  <!-- 3. The problem — centred intro, 2x2 cause-and-effect grid -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>From AI Search guesswork to growth you can actually measure.</h2>
        <p class="lede">
          Most marketing teams are stretched across enough channels as it is;
          AI Search landed on top of that, with no dashboard, no benchmark and
          nobody able to explain it.
        </p>
        <p class="lede section-head__kick">Any of these sound familiar? You&rsquo;re not alone.</p>
      </div>

      <div class="problem-grid" data-stagger>
        {PROBLEMS.map((p) => (
          <div class:list={['card', 'problem', `problem--${p.accent}`]}>
            <span class="problem__n" aria-hidden="true">{p.n}</span>
            <h3>{p.t}</h3>
            <p class="problem__p">{p.p}</p>
            <div class="problem__effect">
              <span class="problem__k">The effect</span>
              <p>{p.e}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3b. The prize. One number and what it means for the reader.
       THE SOURCE BLOCK WAS REMOVED ON JOE'S INSTRUCTION, 2026-08-29. It is
       still carried in PRIZE.source and PRIZE.caveat and is still the only
       reason the figure is on the site at all — it is not ours, it is Muck
       Rack's, and they sell PR software. Anyone editing this number must read
       those two fields before touching the claim. If the citation is wanted
       back on a page, /research is the place for it. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      {/* Not a card any more. Once the source block came off, the box had a
          third of its width doing nothing. A statistic this size does not need
          a container to be read as one — the number is the container. */}
      <figure class="prize">
        <div class="prize__stat">
          <span class="prize__n"><span data-count={PRIZE.n}>{PRIZE.n}</span><span class="prize__s">{PRIZE.suffix}</span></span>
          <p class="prize__claim">{PRIZE.claim}</p>
        </div>
        <p class="prize__point">{PRIZE.point}</p>
      </figure>
    </div>
  </section>

  <!-- 4. The four stages. Numbered cards on a coloured spine, each in its own
       brand hue, arriving in sequence as the spine draws through them. -->
  <section class="section stages">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Delivering it in four stages, in the same order, every time.</h2>
        <p class="lede">Every engagement runs the same four stages, in the same order. We call it SCAN.</p>
      </div>

      <ol class="stages__track" data-timeline>
        <span class="stages__spine" aria-hidden="true"><span class="stages__fill"></span></span>
        {STAGES.map((st, i) => (
          <li class:list={['stages__item', `stages--${st.a}`]} style={`--i:${i}`}>
            <span class="stages__node" aria-hidden="true"></span>
            <article class="stages__card">
              <span class="stages__n" aria-hidden="true">{st.n}</span>
              <p class="stages__when">{st.w}</p>
              <h3 class="stages__t">{st.t}</h3>
              <p class="stages__d">{st.d}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Gradient CTA card, directly above pricing.
       REWRITTEN WHEN IT MOVED HERE, 2026-08-29. It used to sit between the
       problem grid and the demo, where "We fix all four" pointed back at the
       four problems and its lede was the first statement of the method. In
       this position it landed under "Delivering it in four stages" and read as
       a promise about the stages, with a lede restating the four cards
       immediately above it. Its job here is different: hand the reader into
       the prices, and say what the free entry point is. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="cta-card">
        <span class="cta-card__glint" aria-hidden="true"><span class="cta-card__sheen"></span></span>
        <div>
          <h2>Every engagement starts with the same free measurement.</h2>
          <p class="lede">
            We measure it, tell you which of the three causes is keeping you out
            of the answer, and hand you the report. Nothing about it commits you
            to the prices below.
          </p>
        </div>
        <a class="btn cta-card__btn" href="#report">Get a free visibility report</a>
      </div>
    </div>
  </section>

  <!-- 6. Pricing — two cards, gradient headers, prices stated -->
  <section class="section section--sunk" id="pricing">
    <div class="wrap" data-reveal>
      <div class="section-head">
        {/* No subheading here, and none on /service either. The packages
            sections carry a price and a card list; a lede between the heading
            and the cards was hedging in front of the number. */}
        <h2>Two ways we get you there.</h2>
      </div>

      {/* A teaser, not the detail. The full artefact list per package lives on
          /service, which is the page organised around what you buy — repeating
          it here is what made three pages say the same thing. */}
      <div class="price-grid" data-stagger>
        {PACKAGES.map((o) => (
          <div class="card offer">
            <div class="offer__head">
              <h3>{o.name}</h3>
              <span class="offer__price">{o.price}</span>
              <span class="offer__unit">{o.unit}</span>
            </div>
            <div class="offer__body">
              <p>{o.lede}</p>
              <ul>{o.teaser.map((i) => <li>{i}</li>)}</ul>
              <a class:list={['btn', !o.primary && 'btn--ghost']} href={o.primary ? '#report' : '/service#buy'}>{o.cta}</a>
            </div>
          </div>
        ))}
      </div>
      <p class="center-row mt-1"><a class="textlink" href="/service#buy">Everything in both, in full &rarr;</a></p>

      <p class="center-row mt-2">
        <span class="note-sm"><span class="sample-flag">Sample pricing</span> &nbsp;Figures are placeholders for layout. Real pricing is set before launch.</span>
      </p>
    </div>
  </section>

  <!-- 7. Five surfaces. Real prompts by sector, rotating.
       This was four bracketed placeholder rows. A placeholder prompt shows the
       table's shape and nothing else; a real one shows what the product is,
       which is the point of the section. -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2 class="statement statement--sub">Providing everything you need to grow through AI Search.</h2>
        <p class="lede">
          One question. Five different answers. Across five engines. Different
          companies named each time, built from different sources. Pick a sector
          and see.
        </p>
      </div>
      <PromptRotator />
    </div>
  </section>

  <!-- 8. Research teaser -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>We publish what we measure</h2>
        <p class="lede">Method attached to every piece, so you can check it or run it yourself instead of taking our word for it.</p>
      </div>
      <div class="grid grid--3" data-stagger>
        {pieces.map((p) => (
          <a class="card card--link card--tilt" href={`/research/${p.id}`}>
            <p class="meta">
              <time datetime={p.data.published.toISOString().slice(0, 10)}>{p.data.published.toISOString().slice(0, 10)}</time>
              <span class="tag">{p.data.vertical}</span>
              {p.data.placeholder && <span class="tag tag--draft">Placeholder</span>}
            </p>
            <h3>{p.data.title}</h3>
            <p class="note-sm mb-0">{p.data.description}</p>
          </a>
        ))}
      </div>
      <p class="center-row mt-2"><a class="textlink" href="/research">All research &rarr;</a></p>
    </div>
  </section>

  <!-- 8b. Client quotes, between the research teaser and the questions. -->
  <Testimonials />

  <!-- 9. Objections — a subset. The full set lives on /faq. -->
  <section class="section section--sunk">
    <div class="wrap-narrow" data-reveal>
      <div class="section-head">
        <h2>Questions people ask us</h2>
      </div>
      <div class="qa" data-stagger>
        {FAQS_HOME.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="center-row mt-2">
        <a class="btn btn--ghost" href="/faq">See all {FAQS.length} questions</a>
      </p>
    </div>
  </section>

  <!-- 10. CTA — INVERTED band, full section -->
  <section class="section" id="report">
    <div class="wrap">
      <div class="hero-grid">
        <div data-reveal>
          {/* THIS BLOCK IS THE CANONICAL FORM SECTION. It is repeated verbatim
              on /service and /faq — same heading, same lede — because the ask
              is the same ask and three different framings of it read as three
              different offers. Change it here and change it there. */}
          <h2 class="statement statement--sub" data-split>Find out what AI Search is telling your buyers right now.</h2>
          <p class="lede">
            Your category across all five engines. Who gets named, in what
            order, and where each answer came from. It is a top-level read,
            it is free, and there is no obligation attached to it.
          </p>
        </div>
        <ReportForm id="report-form" />
      </div>
    </div>
  </section>
</BaseLayout>
