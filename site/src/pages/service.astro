---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import BookForm from '../components/BookForm.astro';
import { PACKAGES, ENGINES, COST_OF_ABSENCE, NOT_SEO, SETUP, TERMS } from '../data/content';
import { SCAN } from '../data/method';
import { SITE } from '../consts';

/* SERVICE IS THE COMMERCIAL PAGE. What we sell, why it exists, and why this
   buyer needs it now. It shows SCAN and refuses to explain it.

   Until 2026-08-27 this page walked all four stages in as much detail as
   /method did — same four headings, same artefacts, same arguments — so the
   two pages said the same thing twice and neither owned it. The split now:

     /service  organised by what you buy   → packages, artefacts, price
     /method   organised by how it runs    → SCAN in full, the instruments

   The four-letter strip below is the only SCAN content on this page and it
   links out rather than expanding. Anything explaining *how* a stage works
   belongs on /method; anything describing what lands on a desk belongs here. */

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/service#service`,
  name: 'Answer engine optimisation',
  serviceType: 'Answer engine optimisation',
  description:
    'Answer engine visibility measured across ChatGPT, Claude, Perplexity, Gemini, Google and Copilot, the cause of every absence diagnosed, the entity, content and earned-placement work that follows, and a monthly net figure separating what the work moved from what the market moved.',
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  url: `${SITE.url}/service`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Engagements',
    itemListElement: PACKAGES.map((p) => ({
      '@type': 'Offer',
      name: p.name,
      description: p.lede,
    })),
  },
};
---
<BaseLayout
  title="Service"
  description="What we sell and what it costs. Core at AED 6,500 a month or Growth at AED 12,000, with the one time setup fee, the terms and what lands on your desk all stated in full."
  schemas={[serviceSchema]}
>
  <!-- 1. Hero: the offer and the constraint in the same breath. -->
  <section class="hero hero--short">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap svc-hero">
      <div data-load>
        <h1 class="statement" data-split>Knowing where you stand in AI Search, before you spend a thing.</h1>
        <p class="lede">
          We measure your category across all six AI engines and show you
          who&rsquo;s getting named instead of you, and why.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#report">Show me where I stand</a>
          <a class="btn btn--ghost" href="#buy">See what you get</a>
        </div>
      </div>
      <ul class="svc-facts" data-stagger>
        <li><span class="svc-facts__n">{ENGINES.length}</span> <span class="svc-facts__l">engines, measured separately. Never averaged into one score</span></li>
        <li><span class="svc-facts__n">2</span> <span class="svc-facts__l">weeks from agreeing the questions to knowing why you&rsquo;re missing</span></li>
        <li><span class="svc-facts__n">4</span> <span class="svc-facts__l">new companies a quarter. We cap it so the work stays good</span></li>
      </ul>
    </div>
  </section>

  <!-- 2. Why this buyer needs it. The commercial consequence of absence, which
       is a different argument from the home page's "why you’re absent". -->
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>You&rsquo;re losing business here and your reporting says nothing.</h2>
        <p class="lede">
          Three reasons this channel behaves unlike every other one you report
          on.
        </p>
      </div>

      <div class="problem-grid problem-grid--3" data-stagger>
        {COST_OF_ABSENCE.map((c) => (
          <div class:list={['card', 'problem', `problem--${c.a}`]}>
            <span class="problem__n" aria-hidden="true">{c.n}</span>
            <h3>{c.t}</h3>
            <p class="problem__p">{c.p}</p>
            <div class="problem__effect">
              <span class="problem__k">Why it matters</span>
              <p>{c.e}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. What it isn’t. The line against the thing buyers assume it is. -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>This isn&rsquo;t an SEO retainer with a new name.</h2>
        <p class="lede">
          AI Search needs its own strategy, its own budget and its own
          reporting. Bolt it onto an SEO retainer and it gets none of the three;
          you lose business now, and more of it every quarter as AI Search takes
          share from traditional search.
        </p>
      </div>

      <div class="compare" data-stagger>
        <div class="compare__head" aria-hidden="true">
          <span class="compare__t compare__t--axis">The difference</span>
          <span class="compare__t compare__t--seo">Search engine</span>
          <span class="compare__t compare__t--aeo">Answer engine<span class="compare__tag">what we work on</span></span>
        </div>
        {NOT_SEO.map((r, i) => (
          <div class="compare__row">
            <span class="compare__axis"><span class="compare__i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{r.axis}</span>
            <span class="compare__cell compare__cell--seo">
              <span class="compare__mob">Search engine</span>{r.seo}
            </span>
            <span class="compare__cell compare__cell--aeo">
              <span class="compare__mob">Answer engine</span>{r.aeo}
            </span>
          </div>
        ))}
        <p class="compare__foot">
          <strong>Both of these can be true on the same day.</strong> You can
          rank first on Google and still be missing from the AI answer sitting
          above it. That answer gets built from what other sites say about you,
          not from what you say about yourself.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. SCAN, shown and not explained. Four letters, one line each, and a way
       out to the page that owns the detail. -->
  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Every engagement runs the same four stages.</h2>
        <p class="lede">
          We call it SCAN. Same four, same order, every time; taking you from
          where you stand today to measurable growth from AI Search.
        </p>
      </div>

      <ol class="scan-strip" data-stagger>
        {SCAN.map((s) => (
          <li class:list={['scan-strip__i', `stages--${s.a}`]}>
            <span class="scan-strip__k" aria-hidden="true">{s.k}</span>
            <h3 class="scan-strip__t">{s.name}</h3>
            <p class="scan-strip__d">{s.d}</p>
          </li>
        ))}
      </ol>

      <p class="center-row mt-2">
        <a class="btn btn--ghost" href="/method">See how each stage works &rarr;</a>
      </p>
    </div>
  </section>

  <!-- 5. What you buy. Artefacts attached to a purchase, with the price on the
       same card, because "what you get" and "what it costs" are one question. -->
  <section class="section" id="buy">
    <div class="wrap" data-reveal>
      <div class="section-head">
        {/* No subheading. Same rule as the home pricing teaser: the cards
            carry the price and the artefact list, and a lede in between was
            softening the number before the reader reached it. */}
        <h2>Start your AI Search growth one of two ways.</h2>
      </div>

      <div class="pkg" data-stagger>
        {PACKAGES.map((p) => (
          <article class:list={['pkg__c', `stages--${p.a}`]}>
            <div class="pkg__head">
              <p class="pkg__covers">
                <span class="pkg__letters" aria-hidden="true">
                  {SCAN.map((s) => (
                    <span class:list={['pkg__l', p.covers.includes(s.k) && 'is-on', `stages--${s.a}`]}>{s.k}</span>
                  ))}
                </span>
                <span class="pkg__coversl">{p.coversLabel}</span>
              </p>
              <h3 class="pkg__n">{p.name}</h3>
              <p class="pkg__lede">{p.lede}</p>
              <p class="pkg__price"><span class="pkg__pn">{p.price}</span> <span class="pkg__pu">{p.unit}</span></p>
            </div>

            <div class="pkg__body">
              {p.summary && <p class="pkg__s">{p.summary}</p>}

              <p class="pkg__k">What lands on your desk</p>
              <ul class="pkg__gets">
                {p.gets.map((g) => <li>{g}</li>)}
              </ul>

              <p class="pkg__honest"><strong>And plainly:</strong> {p.honest}</p>
              <a class:list={['btn', !p.primary && 'btn--ghost', 'pkg__cta']} href="#book">{p.cta}</a>
            </div>
          </article>
        ))}
      </div>

      {/* Setup is not a fourth card — it is bought alongside either paid tier,
          and both cards already state it in their price line. It sits here as
          a line so the ten-day lead time is visible before the terms. */}
      <p class="pkg__setup">
        <strong>{SETUP.name} &mdash; {SETUP.price}.</strong> {SETUP.d}
      </p>

      <p class="center-row mt-1"><span class="note-sm">{TERMS}</span></p>
    </div>
  </section>

  <!-- 6b. Booking. Both package buttons point here rather than at a bare
       calendar link, so the qualifying detail is captured before a slot is
       given away. See the note at the top of BookForm.astro. -->
  <section class="section section--tight" id="book">
    {/* `wrap`, not `wrap-narrow`. The card inside is capped at the narrow
        width while it holds a form, and the cap lifts when the calendar
        mounts — a booking widget needs room for a month grid and a column of
        times side by side, and at 768px it stacks them and runs enormously
        tall. See `.book-wrap` in global.css. */}
    <div class="wrap book-wrap" data-reveal>
      <div class="section-head">
        <h2 class="statement statement--sub">Book a call.</h2>
        <p class="lede">
          Fifteen minutes on your category, what the six engines are saying
          about it now, and which tier fits. No deck.
        </p>
      </div>
      <BookForm id="book-form" />
    </div>
  </section>

  <!-- 6. The refusal. Kept as its own moment because it’s the whole positioning. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="cta-card">
        <span class="cta-card__glint" aria-hidden="true"><span class="cta-card__sheen"></span></span>
        <div>
          <h2>Sometimes the answer is &ldquo;don&rsquo;t bother yet&rdquo;.</h2>
          <p class="lede">
            If the first measurement shows your category sewn up by two
            competitors with no way in, we&rsquo;ll tell you and turn the work
            down. Be suspicious of any agency whose research always concludes
            that you should hire them.
          </p>
        </div>
        <a class="btn cta-card__btn" href="#report">Start with the measurement</a>
      </div>
    </div>
  </section>

  <section class="section section--sunk" id="report">
    <div class="wrap">
      <div class="hero-grid">
        <div data-reveal>
          {/* Verbatim copy of the canonical form section on the home page.
              Keep the two in step — see the note there. */}
          <h2 class="statement statement--sub" data-split>Find out what AI Search is telling your buyers right now.</h2>
          <p class="lede">
            Your category across all six engines. Who gets named, in what
            order, and where each answer came from. It is a top-level read,
            it is free, and there is no obligation attached to it.
          </p>
        </div>
        <ReportForm id="report-form" heading="Get your free report" />
      </div>
    </div>
  </section>
</BaseLayout>
