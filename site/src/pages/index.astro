---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import LogoStrip from '../components/LogoStrip.astro';
import { SITE } from '../consts';
import { FAQS, FAQS_HOME, HERO_MODE, HERO_STATS, HERO_CASES, PROBLEMS, STAGES, OFFERS, ENGINES } from '../data/content';
import { getCollection } from 'astro:content';

const pieces = (await getCollection('research'))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${SITE.url}/#service`,
  name: 'Answer engine optimisation',
  serviceType: 'Answer engine optimisation',
  description: SITE.description,
  provider: { '@id': `${SITE.url}/#organization` },
  areaServed: SITE.areaServed.map((c) => ({ '@type': 'Country', identifier: c })),
  url: `${SITE.url}/service`,
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  /* Only the questions actually present on this page. The full set is
     marked up on /faq. */
  mainEntity: FAQS_HOME.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* Illustrative shape only — invented statuses, stated as such on the page. */
const demoRows = [
  { label: 'Best employment lawyer in [city]', note: 'buying intent', cells: [
    { status: 'present' as const, citation: 'directory listing' },
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'named, not ranked' },
    { status: 'absent' as const },
  ]},
  { label: 'Alternatives to [incumbent]', note: 'comparison', cells: [
    { status: 'absent' as const },
    { status: 'present' as const, citation: 'own comparison page' },
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'listed sixth' },
  ]},
  { label: 'Who are the top [category] firms', note: 'discovery', cells: [
    { status: 'present' as const, citation: 'trade press' },
    { status: 'present' as const, citation: 'trade press' },
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'local pack only' },
  ]},
  { label: '[brand] vs [competitor]', note: 'head to head', cells: [
    { status: 'absent' as const },
    { status: 'partial' as const, citation: 'competitor page' },
    { status: 'absent' as const },
    { status: 'absent' as const },
  ]},
];

---

<BaseLayout
  title={SITE.name}
  description="Brandure measures where your brand appears in AI-generated answers across ChatGPT, Perplexity, Gemini and Google — then does the work that changes it. Request a free visibility report."
  schemas={[serviceSchema, faqSchema]}
>
  <!-- 1. Hero — statement left, real measured figures right -->
  <section class="hero">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
      <div class="mesh__layer mesh__layer--3"><div class="mesh__blob mesh__blob--3"></div></div>
    </div>
    <div class="wrap hero-grid">
      <div data-load>
        <h1 class="statement" data-split>Your buyers asked an AI. You were not the answer.</h1>
        <p class="lede">
          Your SEO still works. It just stops paying when the answer arrives
          before the links. We measure where you stand inside AI answers, then
          do the work that gets you named.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#report">Get a free visibility report</a>
          <a class="btn btn--violet" href="/service">See how the work runs</a>
        </div>
      </div>

      <div>
        {HERO_MODE === 'stats' ? (
          <>
            <div class="metric-grid" data-stagger>
              {HERO_STATS.map((st) => (
                <div class="metric">
                  <span class="metric__chip">{st.chip}</span>
                  <span class="metric__n">
                    <span data-count={st.n}>{st.n}</span>{st.suffix && <span class="metric__suffix">{st.suffix}</span>}
                  </span>
                  <p class="metric__l">{st.label}</p>
                </div>
              ))}
            </div>
            <p class="figure__src mt-1">
              First three: Pew Research Center, 22 July 2025 — 68,879 Google
              searches by 900+ US adults, March 2025. Google AI Overviews
              specifically, not AI answers in general. The 47% is derived from
              that study’s own 15% and 8%.
            </p>
          </>
        ) : (
          <>
            <div class="metric-grid" data-stagger>
              {HERO_CASES.map((c) => (
                <div class="metric metric--case">
                  <span class="metric__chip">{c.brand}</span>
                  <span class="metric__n">
                    <span>{c.metric}</span>{c.suffix && <span class="metric__suffix">{c.suffix}</span>}
                    <span class="metric__arrow" aria-hidden="true">&#8599;</span>
                  </span>
                  <p class="metric__l">{c.label}</p>
                </div>
              ))}
            </div>
            <p class="figure__src mt-1">
              <span class="sample-flag">Placeholder</span> &nbsp;Every figure
              above is invented and is here to show the layout. Nothing on this
              page is a client result.
            </p>
          </>
        )}
      </div>
    </div>
  </section>

  <!-- 2. Logo strip — inverted band, pill label -->
  <LogoStrip />

  <!-- 3. The problem — centred intro, 2x2 cause-and-effect grid -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>You are not coming up in AI answers, so you are losing buyers you never see</h2>
        <p class="lede">
          Here is what is usually going wrong, and why none of it shows up in a
          dashboard you already look at.
        </p>
      </div>

      <div class="problem-grid" data-stagger>
        {PROBLEMS.map((p) => (
          <div class:list={['card', 'problem', `problem--${p.accent}`]}>
            <span class="problem__n" aria-hidden="true">{p.n}</span>
            <h3>{p.t}</h3>
            <div class="problem__panel">
              <span class="problem__k">The problem</span>
              <p>{p.p}</p>
            </div>
            <div class="problem__panel problem__panel--effect">
              <span class="problem__k">The effect</span>
              <p>{p.e}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Gradient CTA card — the turn from problem to service -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="cta-card">
        <span class="cta-card__glint" aria-hidden="true"><span class="cta-card__sheen"></span></span>
        <div>
          <h2>We fix all four, in that order</h2>
          <p class="lede">
            Find out where you stand, work out why, fix it, then measure again —
            alongside a set of questions we deliberately leave alone, so you can
            see what the work actually did.
          </p>
        </div>
        <a class="btn cta-card__btn" href="#report">Get a free visibility report</a>
      </div>
    </div>
  </section>

  <!-- 5. Four surfaces — INVERTED. No longer pinned.
       This section used to sticky-pin and scrub its rows in against scroll
       position. It read as stuttery and rigid: the reader was held in place
       while rows arrived one at a time, and the scrub was tied to raw scroll
       so every wheel notch stepped the animation rather than easing it. It is
       now an ordinary section that scrolls past like everything else. -->
  <section class="section section--inv">
    <div class="spotlight" aria-hidden="true"></div>
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2 class="statement statement--sub">One question. Four different answers.</h2>
        <p class="lede">
          Ask all four the same thing on the same day and you get four
          different lists of companies, built from four different sets of
          sources. This is what we hand you.
        </p>
      </div>
      <ComparisonTable
        caption="How a visibility report is laid out"
        columns={[...ENGINES]}
        rows={demoRows}
        footnote="Layout illustration. Every status above is invented to show the format — none is a finding about a real brand. Real reports carry the verbatim prompt set, the market, the date and the number of runs per prompt."
      />
    </div>
  </section>

  <!-- 6. How it works — a timeline. The connecting line draws itself as the
       section arrives and each node lands on it in turn, so the sequence is
       legible as a sequence rather than as four boxes in a row. -->
  <section class="section timeline-section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Four stages, and the last one is the point</h2>
        <p class="lede">Anyone can tell you that you are missing. The fourth stage is what tells you whether anything we did changed it.</p>
      </div>

      <ol class="timeline" data-timeline>
        <span class="timeline__line" aria-hidden="true"><span class="timeline__fill"></span></span>
        {STAGES.map((st, i) => (
          <li class="timeline__step" style={`--i:${i}`}>
            <span class="timeline__node" aria-hidden="true"><span class="timeline__dot"></span></span>
            <div class="timeline__body">
              <p class="timeline__when">{st.w}</p>
              <h3>{st.t}</h3>
              <p class="note-sm mb-0">{st.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 7. Pricing — two cards, gradient headers, prices stated -->
  <section class="section section--sunk" id="pricing">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Two ways in</h2>
        <p class="lede">Capacity is deliberately capped. The audit is the front door and stands on its own.</p>
      </div>

      <div class="price-grid" data-stagger>
        {OFFERS.map((o) => (
          <div class="card offer">
            <div class="offer__head">
              <h3>{o.name}</h3>
              <span class="offer__price">{o.price}</span>
              <span class="offer__unit">{o.unit}</span>
            </div>
            <div class="offer__body">
              <p>{o.summary}</p>
              <ul>{o.includes.map((i) => <li>{i}</li>)}</ul>
              <a class:list={['btn', !o.primary && 'btn--ghost']} href={o.primary ? '#report' : '/service'}>{o.cta}</a>
            </div>
          </div>
        ))}
      </div>

      <p class="center-row mt-2">
        <span class="note-sm"><span class="sample-flag">Sample pricing</span> &nbsp;Figures are placeholders for layout. Real pricing is set before launch.</span>
      </p>
    </div>
  </section>

  <!-- 8. Research teaser -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>We publish what we measure</h2>
        <p class="lede">Method attached, so any finding can be checked or repeated rather than taken on trust.</p>
      </div>
      <div class="grid grid--3" data-stagger>
        {pieces.map((p) => (
          <a class="card card--link card--tilt" href={`/research/${p.id}`}>
            <p class="meta">
              <time datetime={p.data.published.toISOString().slice(0, 10)}>{p.data.published.toISOString().slice(0, 10)}</time>
              <span class="tag">{p.data.vertical}</span>
              {p.data.placeholder && <span class="tag tag--draft">Placeholder</span>}
            </p>
            <h3>{p.data.title}</h3>
            <p class="note-sm mb-0">{p.data.description}</p>
          </a>
        ))}
      </div>
      <p class="center-row mt-2"><a class="textlink" href="/research">All research &rarr;</a></p>
    </div>
  </section>

  <!-- 9. Objections — a subset. The full set lives on /faq. -->
  <section class="section section--sunk">
    <div class="wrap-narrow" data-reveal>
      <div class="section-head">
        <h2>The questions we get asked</h2>
      </div>
      <div class="qa" data-stagger>
        {FAQS_HOME.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="center-row mt-2">
        <a class="btn btn--ghost" href="/faq">See all {FAQS.length} questions</a>
      </p>
    </div>
  </section>

  <!-- 10. CTA — INVERTED band, full section -->
  <section class="section section--inv" id="report">
    <div class="spotlight" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero-grid">
        <div data-reveal>
          <h2 class="statement statement--sub" data-split>Find out what the engines say about you.</h2>
          <p class="lede">
            We run your category across all four surfaces and send you what comes
            back — who gets named, in what order, and which sources the answers
            were built from. No charge, no obligation, no sequence.
          </p>
        </div>
        <ReportForm id="report-form" inverted />
      </div>
    </div>
  </section>
</BaseLayout>
