---
import { readdirSync } from 'node:fs';
import { BRANDS } from '../data/brands';

/**
 * Marquee on the light band. Pauses on hover; the hovered logo
 * lifts to full strength.
 *
 * Files are picked up from `public/logos/` by name at build time. Where no
 * file is present a wordmark placeholder is drawn at the same optical height,
 * so the strip's rhythm is right either way — which also means a missing file
 * produces a page that looks finished. If a logo is expected and not showing,
 * check the folder before believing the build.
 *
 * Logos are normalised on optical height, not a fixed box — a wide wordmark
 * and a square mark should read as the same visual weight, which a fixed box
 * does not achieve. See brands.ts for the per-brand multiplier and tone.
 */
let present: string[] = [];
try {
  present = readdirSync('./public/logos');
} catch {
  present = [];
}

/* Prefer the `-light` variant where one exists. Viveonix's original is a white
   knockout with a black outline, and flattening that with brightness(0) merges
   fill and outline into an illegible blob; the light variant has the outline
   removed, so it silhouettes cleanly. */
const byName = (n: string) => present.find((f) => f.replace(/\.[^.]+$/, '') === n);
const items = BRANDS.map((b) => {
  const file = byName(`${b.slug}-light`) ?? byName(b.slug);
  return { ...b, file: file ? `/logos/${file}` : null };
});

/* Four copies, not two. Five logos duplicated once did not fill a wide
   viewport, so the row sat left-aligned with dead space beside it. Four
   always overflow, which is what makes a marquee read as centred. The CSS
   shifts 25% per cycle, so one copy = one seamless loop.
   Only the first set is exposed to assistive tech. */
const track = [...items, ...items, ...items, ...items];
---

<!--
  Light band, like every other section. It was navy because two of the five
  marks are white-knockout artwork; on the light surface all five are now
  rendered as flat dark silhouettes instead, which is uniform and legible
  regardless of what colour each file happens to be drawn in.

  "Trusted by" sits above the strip, plain rather than as a mono-caps pill.
-->
<section class="section--sunk logos" aria-labelledby="logos-h">
  <p class="logos__label" id="logos-h">Trusted by</p>

  <div class="marquee" data-marquee>
    <ul class="marquee__track" role="list">
      {track.map((b, i) => (
        <li class="marquee__item" data-tone={b.tone} aria-hidden={i >= items.length ? 'true' : undefined}>
          {b.file ? (
            <img src={b.file} alt={b.name} loading="lazy" decoding="async"
                 width={b.w} height={b.h} style={`--optical:${b.optical}`} />
          ) : (
            <span class="wordmark-ph" style={`--optical:${b.optical}`}>
              <span class="wordmark-ph__text">{b.name}</span>
            </span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
