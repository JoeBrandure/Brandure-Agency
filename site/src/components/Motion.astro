---
/**
 * The whole motion runtime. One inline script, no dependencies.
 *
 * Everything is additive. If this never runs, CSS keeps `.no-js` on the root
 * and the page renders complete and static. If the visitor prefers reduced
 * motion, the script exits before doing anything except settling final states,
 * and the stylesheet neutralises the rest.
 *
 * Transform and opacity only — no property here triggers layout.
 */
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* Reduced motion: settle everything to its final state and stop. */
    function settle() {
      document.querySelectorAll('[data-reveal],[data-stagger],[data-load],.table-figure,.split')
        .forEach(function (el) { el.classList.add('is-in'); });
      document.querySelectorAll('[data-count]').forEach(function (el) {
        el.textContent = el.getAttribute('data-count');
      });
      document.querySelectorAll('[data-scrub-zone]').forEach(function (el) {
        el.style.setProperty('--p', '1');
      });
    }
    if (reduced.matches) { settle(); return; }

    /* ---- Headline mask reveal, split per word ----
       Spaces are preserved as real text nodes so screen readers still read a
       natural sentence rather than a list of fragments. */
    document.querySelectorAll('[data-split]').forEach(function (el) {
      var words = el.textContent.trim().split(/\s+/);
      var frag = document.createDocumentFragment();
      words.forEach(function (word, i) {
        var mask = document.createElement('span');
        mask.className = 'w';
        var inner = document.createElement('i');
        inner.textContent = word;
        inner.style.setProperty('--w', String(i));
        mask.appendChild(inner);
        frag.appendChild(mask);
        if (i < words.length - 1) frag.appendChild(document.createTextNode(' '));
      });
      el.textContent = '';
      el.className += ' split';
      el.appendChild(frag);
    });

    /* ---- Table rows carry their own stagger index ---- */
    document.querySelectorAll('.table-figure tbody tr').forEach(function (tr, i) {
      tr.style.setProperty('--r', String(i));
    });

    /* ---- Count-ups ---- */
    function countUp(el) {
      var target = parseFloat(el.getAttribute('data-count'));
      if (isNaN(target)) { el.textContent = el.getAttribute('data-count'); return; }
      var dur = 1100, t0 = 0;
      function step(ts) {
        if (!t0) t0 = ts;
        var p = Math.min((ts - t0) / dur, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(target * eased));
        if (p < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    /* ---- One observer drives every entrance ---- */
    var targets = document.querySelectorAll(
      '[data-reveal],[data-stagger],[data-split],.table-figure:not(.pin .table-figure)'
    );
    if (!('IntersectionObserver' in window)) { settle(); return; }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        e.target.querySelectorAll('[data-count]').forEach(countUp);
        io.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });

    targets.forEach(function (el) { io.observe(el); });

    /* Hero enters on load rather than on scroll — it is already in view. */
    requestAnimationFrame(function () {
      document.querySelectorAll('.hero [data-load], .hero [data-split]').forEach(function (el) {
        el.classList.add('is-in');
      });
    });

    /* ---- Scroll progress ---- */
    var bar = document.querySelector('.scroll-progress');
    var header = document.getElementById('site-header');
    var ticking = false;
    function onScroll() {
      var h = document.documentElement;
      var max = h.scrollHeight - h.clientHeight;
      if (bar) bar.style.transform = 'scaleX(' + (max > 0 ? h.scrollTop / max : 0) + ')';
      if (header) header.dataset.scrolled = h.scrollTop > 12 ? 'true' : 'false';
      ticking = false;
    }
    addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true });
    onScroll();

    /* ---- Pointer effects: magnetic buttons, card tilt ----
       Skipped entirely on coarse pointers, where there is no cursor to pull
       toward and the handlers would only cost battery. */
    if (window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll('.btn').forEach(function (b) {
        b.addEventListener('pointermove', function (ev) {
          var r = b.getBoundingClientRect();
          var dx = (ev.clientX - (r.left + r.width / 2)) / (r.width / 2);
          var dy = (ev.clientY - (r.top + r.height / 2)) / (r.height / 2);
          b.style.setProperty('--mx', (dx * 5).toFixed(2) + 'px');
          b.style.setProperty('--my', (dy * 4).toFixed(2) + 'px');
        });
        b.addEventListener('pointerleave', function () {
          b.style.setProperty('--mx', '0px');
          b.style.setProperty('--my', '0px');
        });
      });

      document.querySelectorAll('.card--tilt').forEach(function (c) {
        c.addEventListener('pointermove', function (ev) {
          var r = c.getBoundingClientRect();
          var dx = (ev.clientX - (r.left + r.width / 2)) / (r.width / 2);
          var dy = (ev.clientY - (r.top + r.height / 2)) / (r.height / 2);
          c.style.setProperty('--ry', (dx * 3.2).toFixed(2) + 'deg');
          c.style.setProperty('--rx', (-dy * 3.2).toFixed(2) + 'deg');
          c.style.setProperty('--lift', '-4px');
        });
        c.addEventListener('pointerleave', function () {
          c.style.setProperty('--rx', '0deg');
          c.style.setProperty('--ry', '0deg');
          c.style.setProperty('--lift', '0px');
        });
      });
    }

    /* ---- Scroll-linked scrubbing ----
       Each [data-scrub-zone] gets a --p from 0 to 1 as it passes through the
       viewport. One rAF-throttled pass writes every value; nothing here reads
       layout inside the loop except cached rects, refreshed on resize. */
    var zones = [].slice.call(document.querySelectorAll('[data-scrub-zone]'));
    var rails = [].slice.call(document.querySelectorAll('.rail'));
    var meshLayers = [].slice.call(document.querySelectorAll('.mesh'));
    var draws = [].slice.call(document.querySelectorAll('.draw'));

    /* Line-draw needs each path's own length. */
    draws.forEach(function (d) {
      [].slice.call(d.querySelectorAll('path,line')).forEach(function (el) {
        var len = el.getTotalLength ? el.getTotalLength() : 400;
        el.style.setProperty('--len', String(Math.ceil(len) || 400));
      });
    });

    /* Rows carry their index and count so the CSS can stagger the scrub. */
    document.querySelectorAll('.pin tbody').forEach(function (tb) {
      var trs = tb.querySelectorAll('tr');
      tb.closest('.pin').style.setProperty('--rows', String(trs.length));
    });

    var cache = [];
    function measure() {
      cache = zones.map(function (z) {
        var r = z.getBoundingClientRect();
        return { el: z, top: r.top + window.scrollY, height: r.height };
      });
      rails.forEach(function (rail) {
        var track = rail.querySelector('.rail__track');
        var stage = rail.querySelector('.rail__stage');
        if (!track || !stage) return;
        var shift = Math.max(0, track.scrollWidth - stage.clientWidth);
        rail.style.setProperty('--rail-shift', shift + 'px');
      });
    }

    function scrub() {
      var vh = window.innerHeight;
      for (var i = 0; i < cache.length; i++) {
        var c = cache[i];
        var travel = Math.max(1, c.height - vh);
        var p = (window.scrollY - c.top) / travel;
        c.el.style.setProperty('--p', String(Math.max(0, Math.min(1, p))));
      }
      meshLayers.forEach(function (m) {
        var r = m.getBoundingClientRect();
        m.style.setProperty('--sy', (-r.top * 0.5).toFixed(1) + 'px');
      });
    }

    /* Several things can invalidate geometry at once — load, webfonts, the
       ResizeObserver. Coalesce them into a single pass per frame so the
       forced reflows do not stack. */
    var pendingMeasure = false;
    function remeasure() {
      if (pendingMeasure) return;
      pendingMeasure = true;
      requestAnimationFrame(function () { pendingMeasure = false; measure(); scrub(); });
    }
    measure();
    scrub();
    addEventListener('resize', remeasure, { passive: true });
    addEventListener('load', remeasure);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(remeasure);
    if ('ResizeObserver' in window) {
      var ro = new ResizeObserver(remeasure);
      ro.observe(document.body);
    }

    /* Fold scrubbing into the existing scroll pass rather than adding another. */
    var baseScroll = onScroll;
    onScroll = function () { baseScroll(); scrub(); };
    addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true });

    /* ---- Cursor-following light on dark sections ---- */
    if (window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll('.section--inv').forEach(function (sec) {
        sec.addEventListener('pointermove', function (ev) {
          var r = sec.getBoundingClientRect();
          sec.style.setProperty('--cx', (((ev.clientX - r.left) / r.width) * 100).toFixed(1) + '%');
          sec.style.setProperty('--cy', (((ev.clientY - r.top) / r.height) * 100).toFixed(1) + '%');
        }, { passive: true });
      });
    }

    /* If the visitor turns reduced-motion on mid-session, settle immediately. */
    reduced.addEventListener('change', function (e) { if (e.matches) settle(); });
  })();
</script>
