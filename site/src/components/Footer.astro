---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="wordmark" href="/">BRANDURE</a>
        <p style="margin-top:0.7rem">Answer engine optimisation.<br />Measured, then moved.</p>
      </div>
      <div>
        <h2>Site</h2>
        <ul>
          <li><a href="/service">Service</a></li>
          <li><a href="/method">Method</a></li>
          <li><a href="/work">Case studies</a></li>
          <li><a href="/research">Research</a></li>
          <li><a href="/ai-ready-websites">Websites</a></li>
          <li><a href="/guides">Guides</a></li>
          <li><a href="/faq">Questions</a></li>
        </ul>
      </div>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a href="/#report">Free visibility report</a></li>
        </ul>
      </div>
      <div>
        <h2>Follow</h2>
        <ul>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><button type="button" class="footer-btn" data-cookie-settings>Cookie settings</button></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <p>&copy; {year} {SITE.legalName}.</p>
    </div>
  </div>
</footer>

<style>
  /* A button, not a link, because it performs an action rather than going
     somewhere. Styled to sit in the list unnoticed, from the same values the
     footer's own anchors use — no new tokens. */
  .footer-btn {
    appearance: none; background: none; border: 0; padding: 0;
    font: inherit; color: var(--ink); cursor: pointer; text-align: left;
  }
  .footer-btn:hover { text-decoration: underline; }
</style>
