---
import { POSTHOG, SITE } from '../consts';
/**
 * PostHog, cookieless.
 *
 * persistence: 'memory' means no cookies and no localStorage are written, and
 * person_profiles: 'never' means no identified profile is created. Under UK
 * and EU ePrivacy rules, consent is required for storing or accessing data on
 * a device — storing nothing removes the requirement, so the site needs no
 * cookie banner. That is the minimal, non-intrusive handling the brief asks
 * for, and it works the same way for UAE visitors.
 *
 * The trade-off, recorded honestly: without persistence there is no stable
 * visitor identifier, so counts are per-pageview rather than per-person.
 * Reinstating cookies would require a consent banner.
 *
 * Autocapture and session recording are off. Page views and form submissions
 * only, per the brief.
 *
 * REVIEWED 2026-10-24 against the GA4 consent work: PostHog stays as it is and
 * stays OUTSIDE the consent gate. It writes no cookie and no localStorage
 * identifier, so PECR's "store or access information on a device" trigger is
 * never pulled and consent is not required for it. Gating it would cost the
 * only traffic data the site has before a visitor interacts, in exchange for
 * nothing. GA4 is a different matter — it writes _ga — and is gated.
 */
const { key, host } = POSTHOG;
const { ga4, privacyHref } = SITE;
---

{/* GOOGLE CONSENT MODE v2 — defaults first, always.
    This block runs on every page, before anything measures anything. All four
    signals default to denied; the three ad signals are never granted, because
    the site runs no ads and nothing here should imply it might.

    WHY gtag.js IS NOT LOADED HERE. Consent Mode's own documentation loads the
    tag immediately and lets it send cookieless pings while consent is denied.
    Those pings are still requests to google-analytics.com, which fails both
    the "no GA request before Accept" requirement and the plain reading of
    PECR. So the tag is injected only once analytics consent exists — on this
    page load for a returning visitor who accepted, or on the Accept click.
    The consent default command still precedes every config call either way. */}
<script is:inline define:vars={{ ga4, privacyHref }}>
  (function () {
    var KEY = 'brandure.consent';
    var YEAR = 365 * 24 * 60 * 60 * 1000; // 12 months

    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;

    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
    });

    /* localStorage can throw in a private window or with site data blocked.
       A read that fails is treated as "no choice yet", which shows the banner
       again rather than silently measuring someone. */
    function stored() {
      try {
        var v = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (!v || typeof v.expires !== 'number' || Date.now() > v.expires) return null;
        return v.consent === 'granted' ? 'granted' : 'denied';
      } catch (e) { return null; }
    }

    var loaded = false;
    function loadGa() {
      if (loaded || !ga4) return;
      loaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', ga4);
    }

    function apply(choice) {
      if (choice !== 'granted') return;
      gtag('consent', 'update', { analytics_storage: 'granted' });
      loadGa();
    }

    function persist(choice) {
      try {
        localStorage.setItem(KEY, JSON.stringify({ consent: choice, expires: Date.now() + YEAR }));
      } catch (e) { /* choice is honoured for this page either way */ }
    }

    function hide() {
      var el = document.getElementById('consent');
      if (el) el.hidden = true;
    }

    function show() {
      var el = document.getElementById('consent');
      if (!el) return;
      el.hidden = false;
      var first = el.querySelector('[data-consent]');
      if (first) first.focus();
    }

    /* Exposed so the footer's "Cookie settings" control can reopen the banner
       and so a later choice replaces an earlier one. */
    window.brandureConsent = { show: show, current: stored };

    function wire() {
      var el = document.getElementById('consent');
      if (el) {
        el.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-consent]');
          if (!btn) return;
          var choice = btn.getAttribute('data-consent');
          persist(choice);
          apply(choice);
          hide();
        });
        /* Escape dismisses without granting. Dismissal is not consent, so the
           banner returns on the next visit. */
        el.addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
      }
      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-cookie-settings]')) { e.preventDefault(); show(); }
      });

      var prior = stored();
      if (prior === 'granted') apply('granted');
      else if (prior === null) show();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', wire);
    else wire();
  })();
</script>
<script is:inline define:vars={{ key, host }}>
  (function () {
    function initPostHog() {
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture identify alias people set set_once register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(key, {
        api_host: host,
        persistence: 'memory',
        person_profiles: 'never',
        autocapture: false,
        capture_pageview: true,
        capture_pageleave: false,
        capture_performance: false,
        disable_session_recording: true,
        disable_surveys: true,
      });
      document.addEventListener('submit', function (e) {
        var f = e.target;
        if (f && f.tagName === 'FORM' && f.dataset.track) {
          posthog.capture('report_request_submitted', { form: f.getAttribute('name') });
        }
      });
    }
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initPostHog, { timeout: 5000 });
    } else {
      setTimeout(initPostHog, 1000);
    }
  })();
</script>
