---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PACKAGES, FREE_OFFER } from '../data/content';
import { PLANS, SETUP_FEE, ADDONS, VAT_TERMS, PRICING_FAQS, money } from '../data/pricing';
import PriceBuilder from '../components/PriceBuilder.astro';
import CurrencySwitch from '../components/CurrencySwitch.astro';
import Price from '../components/Price.astro';
import { SITE } from '../consts';
import { allServiceSchemas } from '../lib/schema';

/* PRICING EXISTS BECAUSE THE NUMBERS WERE NOT ADDRESSABLE.
 *
 * The figures were already published — a section on the home page at #pricing
 * and the full cards on /service — but neither is a URL a model can cite. Asked
 * what Brandure costs, ChatGPT answered that the pricing information was
 * inaccessible. A fragment is not a page: it cannot be crawled on its own,
 * returned as a result, or quoted with a source. This page is the citable
 * surface for a number that already existed.
 *
 * No new copy. Every figure, bullet and term renders from src/data/content.ts,
 * the same module the home page and /service read. Prices cannot drift between
 * the three pages because there is only one of each. The markup is this page's
 * own — the home page deliberately shows a teaser and /service the full cards,
 * and this page carries a third shape again (the free report alongside both
 * paid tiers) — but the words are shared by construction.
 */

const offerId = (k: string) => `${SITE.url}/pricing#offer-${k}`;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}/pricing#webpage`,
  url: `${SITE.url}/pricing`,
  name: 'Pricing',
  description:
    'Brandure AEO pricing: Core AED 6,500/month, Growth AED 12,000/month, plus a one-time AED 3,500 setup. Six-month term with a 90-day review. Prices exclude VAT.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#organization` },
  /* The prices on this page are the prices of that service. */
  mainEntity: { '@id': `${SITE.url}/#service` },
};

/* Every node carries its own @id and every cross-reference is a bare {"@id"}.
   An anonymous seller repeated across three offers is three sellers as far as
   a consumer is concerned, which is the duplication the entity graph work
   removed everywhere else on the site. */
const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  '@id': `${SITE.url}/pricing#catalog`,
  name: 'Brandure engagements',
  url: `${SITE.url}/pricing`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  provider: { '@id': `${SITE.url}/#organization` },
  itemListElement: [
    ...PLANS.map((p) => ({
      '@type': 'Offer',
      '@id': offerId(p.key),
      name: p.name,
      description: p.includes,
      url: `${SITE.url}/pricing`,
      /* All three currencies. The top-level price stays AED for consumers
         that read only that; the UnitPriceSpecifications carry the real set.
         Each is a fixed, rounded price, not a conversion of the others — a
         consumer that treats them as an exchange rate will be wrong, which is
         why they are published as separate specifications rather than one
         price plus a rate. */
      priceCurrency: 'AED',
      price: p.monthly.aed,
      seller: { '@id': `${SITE.url}/#organization` },
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: p.monthly.aed, priceCurrency: 'AED', unitText: 'MONTH' },
        { '@type': 'UnitPriceSpecification', price: p.monthly.gbp, priceCurrency: 'GBP', unitText: 'MONTH' },
        { '@type': 'UnitPriceSpecification', price: p.monthly.usd, priceCurrency: 'USD', unitText: 'MONTH' },
      ],
    })),
    {
      '@type': 'Offer',
      '@id': offerId('setup'),
      name: SETUP_FEE.name,
      description: SETUP_FEE.d,
      url: `${SITE.url}/pricing`,
      priceCurrency: 'AED',
      price: SETUP_FEE.price.aed,
      seller: { '@id': `${SITE.url}/#organization` },
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: SETUP_FEE.price.aed, priceCurrency: 'AED' },
        { '@type': 'UnitPriceSpecification', price: SETUP_FEE.price.gbp, priceCurrency: 'GBP' },
        { '@type': 'UnitPriceSpecification', price: SETUP_FEE.price.usd, priceCurrency: 'USD' },
      ],
    },
    ...ADDONS.filter((a) => a.price).map((a) => ({
      '@type': 'Offer',
      '@id': offerId(a.key),
      name: a.label,
      description: a.notes,
      url: `${SITE.url}/pricing`,
      priceCurrency: 'AED',
      price: a.price.aed,
      seller: { '@id': `${SITE.url}/#organization` },
      priceSpecification: [
        { '@type': 'UnitPriceSpecification', price: a.price.aed, priceCurrency: 'AED', ...(a.perPage ? { unitText: 'PAGE' } : {}) },
        { '@type': 'UnitPriceSpecification', price: a.price.gbp, priceCurrency: 'GBP', ...(a.perPage ? { unitText: 'PAGE' } : {}) },
        { '@type': 'UnitPriceSpecification', price: a.price.usd, priceCurrency: 'USD', ...(a.perPage ? { unitText: 'PAGE' } : {}) },
      ],
    })),
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE.url}/pricing#faq`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: PRICING_FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title="Pricing | Brandure: AEO agency for UK & UAE businesses"
  fullTitle
  description="Brandure AEO pricing: Core AED 6,500/month, Growth AED 12,000/month, plus a one-time AED 3,500 setup. Six-month term with a 90-day review. Prices exclude VAT."
  schemas={[webPageSchema, ...allServiceSchemas, catalogSchema, faqSchema]}
>
  {/* 1 · SHORT HERO. The old hero ran a lede explaining the page; a buyer who
      clicked "Pricing" does not need the page explained. One line.

      ONE COLUMN. It was a two-column grid with the currency switch in the
      right-hand column, so "Pricing" and the intro line were centred in the
      LEFT column rather than on the page — 130px off the axis everything
      below them sits on, and the title a pixel off its own intro line.
      Centring inside a column is not centring on the page. */}
  <section class="hero hero--short pr-hero">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
    </div>
    <div class="wrap" data-load>
      <h1 class="statement statement--sub" data-split>Pricing</h1>
      <p class="lede">
        Pick a plan, add what you need, and see your total before we talk.
        Prices exclude VAT.
      </p>
    </div>
  </section>

  {/* The switch, on its own row between the hero and step 1. It belongs to
      the builder rather than to the title, and keeping it out of the hero is
      what lets the hero centre on the page. Its own row rather than beside
      "Choose your plan": sharing that line would mean positioning it against
      a centred heading, and the heading staying centred matters more than the
      row of vertical space this costs. */}
  <div class="pr-curbar"><CurrencySwitch /></div>

  {/* 2 · THE BUILDER, immediately. This is what the page is for. */}
  <PriceBuilder />

  {/* 3 · Not ready to buy. A slim band, replacing the large report card that
      used to sit above the plans and pushed the prices below the fold. */}
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="pr-band">
        <p class="pr-band__t"><strong>Not ready to buy?</strong> Start with a free AI visibility report.</p>
        <a class="btn btn--ghost" href={FREE_OFFER.href}>{FREE_OFFER.cta}</a>
      </div>
    </div>
  </section>

  {/* 4 · What is in each plan. The detail the cards above deliberately omit. */}
  <section class="section section--sunk" aria-labelledby="incl-h">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2 id="incl-h">What&rsquo;s in each plan</h2>
      </div>
      <div class="pkg" data-stagger>
        {PACKAGES.map((p, i) => (
          <article class:list={['pkg__c', `stages--${p.a}`, p.primary && 'is-featured']}>
            {p.primary && <span class="feat-ring" aria-hidden="true"></span>}
            <div class="pkg__head">
              <h3 class="pkg__n">{p.name}</h3>
              <p class="pkg__lede">{p.lede}</p>
              {/* The setup fee was the one figure on this card still frozen
                  as a string, so the card read "$1,800 ... plus AED 3,500" —
                  two currencies on one card. */}
              <p class="pkg__price">
                <span class="pkg__pn"><Price m={PLANS[i].monthly} /></span>
                <span class="pkg__pu">per month &middot; plus <Price m={SETUP_FEE.price} /> one time setup fee</span>
              </p>
            </div>
            <div class="pkg__body">
              {p.summary && <p class="pkg__s">{p.summary}</p>}
              <p class="pkg__k">What lands on your desk</p>
              <ul class="pkg__gets">{p.gets.map((g) => <li>{g}</li>)}</ul>
              <a class:list={['btn', !p.primary && 'btn--ghost', 'pkg__cta']} href="#builder">Build this plan</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 5 · Website work in detail. */}
  <section class="section" aria-labelledby="web-h">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2 id="web-h">Website work in detail</h2>
        {/* The space before the link is written, not left to the newline:
            Astro collapses the whitespace between text and an element on the
            next line, which is how this read "More onhow we build". */}
        <p class="lede">
          Added to a plan, never sold on its own. More on{' '}
          <a href="/ai-ready-websites">how we build</a>.
        </p>
      </div>
      <div class="pr-grid" data-stagger>
        {ADDONS.map((a) => (
          <article class="card pr-wcard">
            <h3>{a.label}</h3>
            <p class="pr-wcard__p">
              {a.price
                ? <><Price m={a.price} />{a.perPage ? ' per page' : ''}</>
                : 'Quoted'}
            </p>
            <p class="pr-wcard__d">{a.notes}</p>
            <p class="note-sm">
              {a.key === 'page' && 'Two to three weeks.'}
              {a.key === 'rebuild10' && 'Four to six weeks.'}
              {a.key === 'rebuild20' && 'Four to six weeks.'}
              {a.key === 'ecommerce' && 'Scoped with you before anything starts.'}
              {a.key === 'copy' && 'Written alongside the build.'}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* 6 · THE FULL PRICE LIST. Every row carries all three currencies in the
      HTML, so a crawler and a reader with no JS get every figure; the CSS
      shows the selected one and hides the separators once JS confirms the
      switch can run. Nothing is removed from the page in any state — the
      whole point of this section is that the numbers are addressable. */}
  <section class="section section--sunk" aria-labelledby="list-h">
    <div class="wrap-narrow" data-reveal>
      <div class="section-head">
        <h2 id="list-h">Full price list</h2>
        <p class="lede">Every figure excludes VAT.</p>
      </div>

      <CurrencySwitch />

      <dl class="plist">
        {PLANS.map((p) => (
          <>
            <dt>{p.name} plan</dt>
            <dd><Price m={p.monthly} all /> a month</dd>
          </>
        ))}
        <dt>{SETUP_FEE.name}</dt>
        <dd><Price m={SETUP_FEE.price} all /> one-off</dd>
        {ADDONS.map((a) => (
          <>
            <dt>{a.label}</dt>
            <dd>{a.price ? <><Price m={a.price} all />{a.perPage ? ' per page' : ''}</> : 'Quoted'}</dd>
          </>
        ))}
      </dl>

      <p class="note-sm plist__terms">{VAT_TERMS}</p>
      {/* ONE SENTENCE, ONE FLEX ITEM. This was two lines: a Dubai plug and a
          bare "UAE | UK" pair that did not say where either link went.
          .center-row is display:flex with a 1.75rem column gap, so the
          sentence also has to stay inside a single span or the gap opens up
          between its words. The Dubai link is gone from this page; it is
          still reached from the home page, /service and the footer. */}
      <p class="center-row mt-1 note-sm">
        <span>
          How our prices compare with other agencies:{' '}
          <a class="textlink" href="/guides/aeo-cost-uae">UAE</a> &middot;{' '}
          <a class="textlink" href="/guides/aeo-cost-uk">UK</a>
        </span>
      </p>
    </div>
  </section>

  {/* 7 · FAQs. */}
  <section class="section">
    <div class="wrap-narrow" data-reveal>
      <div class="section-head">
        <h2>Pricing questions</h2>
      </div>
      <div class="qa">
        {PRICING_FAQS.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="center-row mt-2">
        <a class="textlink" href="/service#buy">Everything in both, in full &rarr;</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* The switch row is the builder's width, not the page's, so its right edge
     lands on the right edge of the plan-card column rather than 224px further
     out at the edge of .wrap — which is where it sat when it was a hero
     column, and why it read as belonging to the title. Centred on a phone,
     where there is no spare width to align to. */
  .pr-curbar {
    width: min(100% - 2.5rem, var(--wrap-narrow));
    margin: 1.5rem auto 0;
    display: flex; justify-content: center;
  }
  @media (min-width: 48rem) { .pr-curbar { justify-content: flex-end; } }

  .pr-band {
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;
    justify-content: space-between;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface-sunk); padding: 1rem 1.25rem;
  }
  .pr-band__t { margin: 0; font-size: var(--small); }

  /* FIVE CARDS IN THREE COLUMNS LEAVES TWO ON THEIR OWN. As a grid they sat
     against the left edge of the second row with a column of empty space
     beside them. Flex wrapping with a fixed basis puts the remainder in the
     middle instead — same card width, same gutter, same breakpoints, which is
     why the basis is written as the share of the row a grid column would have
     had rather than as a round number. */
  .pr-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
  .pr-grid > * { flex: 0 1 100%; }
  @media (min-width: 40rem) { .pr-grid > * { flex-basis: calc((100% - 1rem) / 2); } }
  @media (min-width: 64rem) { .pr-grid > * { flex-basis: calc((100% - 2rem) / 3); } }
  .pr-wcard { padding: 1.15rem 1.2rem; }
  .pr-wcard h3 { font-size: var(--h3); margin: 0 0 0.35rem; }
  .pr-wcard__p { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.02em; margin: 0 0 0.45rem; }
  .pr-wcard__d { font-size: var(--small); margin: 0 0 0.5rem; }

  /* Reference list, not a table: item left, price right, hairline between. */
  .plist { display: grid; grid-template-columns: 1fr auto; gap: 0; margin: 0; }
  .plist dt, .plist dd {
    margin: 0; padding: 0.7rem 0; border-top: 1px solid var(--border);
    font-size: var(--small);
  }
  .plist dt { font-weight: 600; padding-right: 1rem; }
  .plist dd { text-align: right; color: var(--muted); white-space: nowrap; }
  .plist__terms { margin-top: 1rem; }
</style>
