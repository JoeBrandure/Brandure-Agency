---
/**
 * Placeholder imagery, generated in code from the palette.
 *
 * No photography, no stock, no external requests, no abstract "AI" imagery.
 * Every variant is drawn from the same tokens as the rest of the site, so it
 * changes with the theme. Aspect ratios are fixed so real assets drop into the
 * same boxes later without reflow.
 */
interface Props {
  variant?: 'mesh' | 'grid' | 'panel' | 'bars' | 'specimen' | 'table';
  ratio?: '16x9' | '4x3' | '1x1';
  label?: string;
}
const { variant = 'mesh', ratio = '16x9', label = 'Placeholder' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---
<div class:list={['ph', `ph--${ratio}`, `ph--${variant}`]} role="img"
     aria-label={`${label} — placeholder graphic, generated from the palette`}>
  <svg viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id={`g-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--violet)" stop-opacity="0.22" />
        <stop offset="55%" stop-color="var(--accent)" stop-opacity="0.14" />
        <stop offset="100%" stop-color="var(--teal-vivid)" stop-opacity="0.2" />
      </linearGradient>
      <radialGradient id={`r1-${uid}`}><stop offset="0%" stop-color="var(--violet)" stop-opacity="0.55" /><stop offset="100%" stop-color="var(--violet)" stop-opacity="0" /></radialGradient>
      <radialGradient id={`r2-${uid}`}><stop offset="0%" stop-color="var(--teal-vivid)" stop-opacity="0.5" /><stop offset="100%" stop-color="var(--teal-vivid)" stop-opacity="0" /></radialGradient>
      <radialGradient id={`r3-${uid}`}><stop offset="0%" stop-color="var(--accent)" stop-opacity="0.45" /><stop offset="100%" stop-color="var(--accent)" stop-opacity="0" /></radialGradient>
    </defs>

    <rect width="320" height="180" fill={`url(#g-${uid})`} />

    {variant === 'mesh' && (
      <g class="ph-mesh">
        <circle class="ph-b1" cx="70" cy="60" r="86" fill={`url(#r1-${uid})`} />
        <circle class="ph-b2" cx="250" cy="130" r="92" fill={`url(#r2-${uid})`} />
        <circle class="ph-b3" cx="180" cy="40" r="74" fill={`url(#r3-${uid})`} />
      </g>
    )}

    {variant === 'grid' && (
      <g stroke="var(--border)" stroke-width="0.6" opacity="0.9">
        {[36, 72, 108, 144].map((y) => <line x1="16" y1={y} x2="304" y2={y} />)}
        {[80, 144, 208, 272].map((x) => <line x1={x} y1="16" x2={x} y2="164" />)}
        <circle cx="144" cy="72" r="3.5" fill="var(--accent)" stroke="none" />
        <circle cx="208" cy="108" r="3.5" fill="var(--violet)" stroke="none" />
      </g>
    )}

    {variant === 'panel' && (
      <g>
        <rect x="18" y="18" width="284" height="26" rx="5" fill="var(--surface)" opacity="0.8" />
        <rect x="28" y="28" width="88" height="6" rx="3" fill="var(--accent)" opacity="0.6" />
        <circle cx="288" cy="31" r="4" fill="var(--teal-vivid)" opacity="0.7" />
        <rect x="18" y="54" width="136" height="108" rx="6" fill="var(--surface)" opacity="0.65" />
        <rect x="30" y="70" width="80" height="5" rx="2.5" fill="var(--muted)" opacity="0.5" />
        <rect x="30" y="84" width="104" height="5" rx="2.5" fill="var(--muted)" opacity="0.35" />
        <rect x="166" y="54" width="136" height="50" rx="6" fill="var(--surface)" opacity="0.65" />
        <rect x="166" y="112" width="136" height="50" rx="6" fill="var(--surface)" opacity="0.65" />
      </g>
    )}

    {variant === 'bars' && (
      <g>
        {[[40, 60], [86, 96], [132, 44], [178, 120], [224, 78], [270, 104]].map(([x, h], i) => (
          <rect x={x - 14} y={160 - h} width="28" height={h} rx="4"
                fill={i % 3 === 0 ? 'var(--violet)' : i % 3 === 1 ? 'var(--accent)' : 'var(--teal-vivid)'}
                opacity="0.42" />
        ))}
        <line x1="16" y1="160" x2="304" y2="160" stroke="var(--border)" stroke-width="1" />
      </g>
    )}

    {variant === 'specimen' && (
      <g>
        <text x="20" y="86" font-family="var(--font-display)" font-size="62" font-weight="700"
              letter-spacing="-2.4" fill="var(--ink)" opacity="0.82">Aa</text>
        <text x="150" y="66" font-family="var(--font-mono)" font-size="11" fill="var(--accent)">Manrope 700</text>
        <text x="150" y="84" font-family="var(--font-mono)" font-size="11" fill="var(--muted)">Inter 400</text>
        <text x="150" y="102" font-family="var(--font-mono)" font-size="11" fill="var(--muted)">IBM Plex Mono</text>
        <line x1="20" y1="118" x2="300" y2="118" stroke="var(--border)" stroke-width="1" />
        <text x="20" y="146" font-family="var(--font-mono)" font-size="13" fill="var(--muted)">0123456789 · tabular</text>
      </g>
    )}

    {variant === 'table' && (
      <g>
        <rect x="16" y="20" width="288" height="22" rx="4" fill="var(--surface-sunk)" />
        {['Prompt', 'GPT', 'PPLX', 'Gem'].map((t, i) => (
          <text x={26 + i * 72} y="35" font-family="var(--font-mono)" font-size="9" fill="var(--muted)">{t}</text>
        ))}
        {[0, 1, 2, 3].map((r) => (
          <g>
            <line x1="16" y1={54 + r * 30} x2="304" y2={54 + r * 30} stroke="var(--border)" stroke-width="0.7" />
            <rect x="26" y={62 + r * 30} width={52 - r * 6} height="5" rx="2.5" fill="var(--muted)" opacity="0.45" />
            {[0, 1, 2].map((c) => (
              <circle cx={104 + c * 72} cy={64 + r * 30} r="4"
                      fill={(r + c) % 3 === 0 ? 'var(--status-present)' : (r + c) % 3 === 1 ? 'var(--status-partial)' : 'var(--status-absent)'}
                      opacity="0.85" />
            ))}
          </g>
        ))}
      </g>
    )}
  </svg>
</div>
