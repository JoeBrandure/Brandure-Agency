---
/**
 * Inline confirmation for Netlify forms. Progressive enhancement only.
 *
 * WHAT THIS REPLACES AND WHY. Two earlier attempts were wrong in different
 * ways. The first branched on `Astro.url.searchParams` — dead on a static
 * build, so submitters saw the empty form again and assumed failure. The
 * second redirected to /thanks, which confirmed the submission but navigated
 * the reader off the page they were reading and replaced everything on it.
 *
 * This one submits in place. The form is swapped for a confirmation panel,
 * nothing else on the page changes, the reader can scroll anywhere, and a
 * reload brings the form back because no state is stored anywhere.
 *
 * WITH JAVASCRIPT OFF the form still works: the `action` on each form points
 * at a real confirmation route, so a no-JS submit is an ordinary POST and
 * Netlify redirects there. The same route catches a failed fetch. That is why
 * /thanks and /thanks-call still exist and should not be deleted.
 *
 * NETLIFY AJAX CONTRACT: POST url-encoded to any path on the site with
 * `form-name` in the body. The honeypot rides along in the FormData.
 */
---
<script is:inline>
  (function () {
    var forms = document.querySelectorAll('form[data-ajax]');
    if (!forms.length || !window.fetch) return;

    forms.forEach(function (form) {
      form.addEventListener('submit', function (e) {
        /* Let the browser do its own validation first. If it fails, this
           handler never runs, so required fields behave normally. */
        if (!form.checkValidity()) return;
        e.preventDefault();

        var btn = form.querySelector('button[type="submit"]');
        var original = btn ? btn.textContent : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

        fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form)).toString(),
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Netlify returned ' + res.status);

            var panel = document.createElement('div');
            panel.className = 'form-done';
            panel.setAttribute('role', 'status');
            panel.setAttribute('tabindex', '-1');

            var h = document.createElement('p');
            h.className = 'form-done__t';
            h.textContent = form.getAttribute('data-done-title') || 'Got it, thanks.';

            var p = document.createElement('p');
            p.className = 'form-done__b';
            p.textContent = form.getAttribute('data-done-body') || '';

            panel.appendChild(h);
            if (p.textContent) panel.appendChild(p);

            /* The calendar itself, not a link to it. Only when the form
               carries an embed URL — otherwise the panel is just the message.

               The Calendly script is loaded HERE, on success, and never on
               page load. Nobody browsing the site is served a third-party
               script or given a third-party cookie unless they have already
               chosen to book. */
            var embed = form.getAttribute('data-done-embed');
            if (embed) {
              var cal = document.createElement('div');
              cal.className = 'form-done__cal';
              /* Something in the box while the script is in flight, so the
                 reader is not looking at 42rem of nothing wondering whether
                 it broke. Replaced the moment the widget mounts. */
              var wait = document.createElement('p');
              wait.className = 'form-done__wait';
              wait.textContent = 'Loading the calendar…';
              cal.appendChild(wait);
              panel.appendChild(cal);

              /* Match the widget to whichever theme is showing. Calendly takes
                 these as bare hex in the query string, no leading hash. */
              var cs = getComputedStyle(document.documentElement);
              var hex = function (name, fallback) {
                var v = cs.getPropertyValue(name).trim().replace('#', '');
                return /^[0-9a-fA-F]{6}$/.test(v) ? v : fallback;
              };
              var url = embed
                + (embed.indexOf('?') > -1 ? '&' : '?')
                + 'hide_gdpr_banner=1&hide_landing_page_details=1'
                + '&background_color=' + hex('--surface', 'ffffff')
                + '&text_color=' + hex('--ink', '14181f')
                + '&primary_color=' + hex('--accent', '2f5bff');

              /* Everything they just typed, carried into the booking so the
                 slot arrives with its context attached. a1 is the event's one
                 custom question. */
              var val = function (n) {
                var f = form.elements[n];
                return f && f.value ? f.value : '';
              };
              var context = [
                val('company') ? 'Company: ' + val('company') : '',
                val('website') ? 'Site: ' + val('website') : '',
                val('category') ? 'Category: ' + val('category') : '',
                val('market') ? 'Market: ' + val('market') : 'Market: not specified',
                val('tier') ? 'Asking about: ' + val('tier') : ''
              ].filter(Boolean).join('\n');

              var mount = function () {
                if (!window.Calendly) return;
                if (wait.parentNode) wait.remove();
                window.Calendly.initInlineWidget({
                  url: url,
                  parentElement: cal,
                  prefill: {
                    name: val('name'),
                    email: val('email'),
                    customAnswers: { a1: context }
                  }
                });
              };

              if (window.Calendly) {
                mount();
              } else if (!document.getElementById('calendly-widget-js')) {
                var sc = document.createElement('script');
                sc.id = 'calendly-widget-js';
                sc.src = 'https://assets.calendly.com/assets/external/widget.js';
                sc.async = true;
                sc.onload = mount;
                /* If Calendly cannot load, the reader still gets a way through
                   rather than an empty box. */
                sc.onerror = function () {
                  cal.innerHTML = '';
                  var a = document.createElement('a');
                  a.className = 'btn';
                  a.href = embed;
                  a.target = '_blank';
                  a.rel = 'noopener';
                  a.textContent = 'Pick a time';
                  cal.appendChild(a);
                };
                document.head.appendChild(sc);
              }
            }

            /* The line introducing the form is stale the moment it is
               submitted, so it goes with it. */
            var intro = form.parentNode
              ? form.parentNode.querySelector('[data-form-intro]')
              : null;
            if (intro) intro.remove();

            /* Swap the form for the panel. Only the form goes — the section
               around it, the page, and every other section stay exactly as
               they were, so nothing about scrolling changes. */
            form.replaceWith(panel);

            /* Announce it to a screen reader and put the keyboard somewhere
               sensible, without yanking the viewport around. */
            panel.focus({ preventScroll: true });
            var top = panel.getBoundingClientRect().top;
            if (top < 0 || top > window.innerHeight) {
              panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          })
          .catch(function () {
            /* Anything at all goes wrong and we hand it back to the browser,
               which posts normally and lands on the form's action route. The
               submission is never silently dropped. */
            if (btn) { btn.disabled = false; btn.textContent = original; }
            form.removeAttribute('data-ajax');
            form.submit();
          });
      });
    });
  })();
</script>
