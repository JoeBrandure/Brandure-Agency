---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderArt from '../../components/PlaceholderArt.astro';
import { CASES } from '../../data/cases';
---
<BaseLayout
  title="Case studies"
  description="Engagement write-ups: the baseline, the work, and the measured change against a control set. Sample entries pending real client results."
  noindex
>
  <section class="hero">
    <div class="wrap-narrow">
      <p class="eyebrow">Case studies</p>
      <h1 class="statement" style="font-size:var(--step-4)" data-split>The work, with the numbers attached.</h1>
      <p class="lede">Every write-up carries the day-zero baseline, the control set and the raw counts. Nothing else is publishable.</p>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap" data-reveal>
      <div class="card" style="border-style:dashed">
        <p style="margin:0"><span class="sample-flag">Sample entries</span> &nbsp;<strong>No client work has been published.</strong> The entries below are invented, use generic names, and imply no existing client relationship. They exist so the route pattern and layout can be judged. This page is excluded from search indexing until real cases replace them.</p>
      </div>
      <div class="grid grid--3" style="margin-top:2rem" data-stagger>
        {CASES.map((c) => (
          <a class="card card--link card--tilt" href={`/work/${c.slug}`}>
            <PlaceholderArt variant={c.art} ratio="16x9" label={c.name} />
            <p class="meta" style="margin-top:0.9rem"><span class="tag">{c.sector}</span><span class="tag tag--draft">Sample</span></p>
            <h2 style="font-size:var(--step-1)">{c.name}</h2>
            <p style="font-size:var(--step--1);color:var(--muted)">{c.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
