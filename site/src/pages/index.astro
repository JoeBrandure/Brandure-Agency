---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReportForm from '../components/ReportForm.astro';
import PromptRotator from '../components/PromptRotator.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Testimonials from '../components/Testimonials.astro';
import { SITE } from '../consts';
import { allServiceSchemas } from '../lib/schema';
import { PLANS, ADDONS, money } from '../data/pricing';

const WEB_PAGE = ADDONS.find((a) => a.key === 'page')!;
import { FAQS, FAQS_HOME, HERO_MODE, HERO_STATS, HERO_CASES, PROBLEMS, STAGES, PACKAGES, ENGINES, PRIZE, TERMS } from '../data/content';
import { getCollection } from 'astro:content';
import { listable, sortDate, tagFor } from '../lib/research';
import { readdirSync } from 'node:fs';

/* Same lookup the strip uses: match a file in public/logos/ by slug. */
let logoFiles: string[] = [];
try { logoFiles = readdirSync('./public/logos'); } catch { logoFiles = []; }
/* Each card carries the mark twice — one file for the light theme, one for
   the dark — because no single version of these four works on both. Lurio and
   Viveonix ship as white-knockout artwork and need dark-ink variants on a
   light card; Little Lockets and Fresh Gym are dark artwork and need lightened
   variants on a dark one. CSS shows one and hides the other.
   Naming: `<slug>-light.*` and `<slug>-dark.*`, falling back to `<slug>.*`.
   How each variant was derived is in public/logos/README.md. */
const byName = (n: string) => logoFiles.find((f) => f.replace(/\.[^.]+$/, '') === n);
const caseCards = HERO_CASES.map((c) => ({
  ...c,
  light: byName(`${c.slug}-light`) ?? byName(c.slug),
  dark: byName(`${c.slug}-dark`) ?? byName(c.slug),
}));

const pieces = listable(await getCollection('research')).slice(0, 3);

/* Defined once in src/lib/schema.ts and emitted here, on /service and on
   /pricing, so the three pages cannot describe the service differently. */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  /* The only anonymous entity node left on the site, given an @id here so the
     home page's FAQ is a thing that can be referred to, like /faq#faq is.
     Out of this task's scope but one line, and it was the last one. */
  '@id': `${SITE.url}/#faq`,
  /* Only the questions actually present on this page. The full set is
     marked up on /faq. */
  mainEntity: FAQS_HOME.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---

<BaseLayout
  title="Brandure | AI search (AEO) & SEO agency, UK & UAE"
  fullTitle
  description="Brandure is an AI search optimisation (AEO) agency for UK and UAE businesses. We get you recommended by ChatGPT, Gemini, Perplexity and Google AI Overviews."
  schemas={[...allServiceSchemas, faqSchema]}
>
  <!-- 1. Hero — statement centred, case figures in a row beneath (centre.css) -->
  <section class="hero">
    <div class="mesh" aria-hidden="true">
      <div class="mesh__layer mesh__layer--1"><div class="mesh__blob mesh__blob--1"></div></div>
      <div class="mesh__layer mesh__layer--2"><div class="mesh__blob mesh__blob--2"></div></div>
      <div class="mesh__layer mesh__layer--3"><div class="mesh__blob mesh__blob--3"></div></div>
    </div>
    <div class="wrap hero-grid">
      <div data-load class="is-in">
        <h1 class="statement" data-split>Turning AI Search from a blind spot into a revenue channel.</h1>
        <p class="lede">
          AI search optimisation, SEO and websites built for both, for
          businesses in the UK and UAE.
        </p>
        <div class="hero-actions">
          <a class="btn" href="#report">Show me where I stand</a>
          <a class="btn btn--violet" href="/pricing">Build your plan</a>
        </div>
      </div>

      <div>
        {HERO_MODE === 'stats' ? (
          <>
            <div class="metric-grid" data-stagger>
              {HERO_STATS.map((st) => (
                <div class="metric">
                  <span class="metric__chip">{st.chip}</span>
                  <span class="metric__n">
                    <span data-count={st.n}>{st.n}</span>{st.suffix && <span class="metric__suffix">{st.suffix}</span>}
                  </span>
                  <p class="metric__l">{st.label}</p>
                </div>
              ))}
            </div>
            <p class="figure__src mt-1">
              First three: Pew Research Center, 22 July 2025 — 68,879 Google
              searches by 900+ US adults, March 2025. Google AI Overviews
              specifically, not AI answers in general. The 47% is derived from
              that study’s own 15% and 8%.
            </p>
          </>
        ) : (
          <div class="case-grid" data-stagger>
            {caseCards.map((c) => (
              <figure class="case">
                <span class="case__mark" style={`--optical:${c.optical}`}>
                  {c.light ? (
                    <>
                      <img class="on-light" src={`/logos/${c.light}`} alt={c.brand} decoding="async" />
                      <img class="on-dark" src={`/logos/${c.dark}`} alt="" aria-hidden="true" decoding="async" loading="lazy" />
                    </>
                  ) : (
                    <span class="case__wordmark">{c.brand}</span>
                  )}
                </span>
                <figcaption>
                  <span class="case__n">
                    <span data-count={c.metric}>{c.metric}</span><span class="case__suffix">{c.suffix}</span>
                  </span>
                  <span class="case__l">{c.label}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  {/* 1b. Three ways in. AI search leads and is emphasised; SEO and websites
       are what most people arrive looking for. Prices are "from" figures in
       the visitor's currency, using the same spans as everywhere else. */}
  <section class="section section--tight" aria-labelledby="ways-h">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2 id="ways-h">Three ways we get you found.</h2>
      </div>
      {/* A CARD IS NOT A LINK ANY MORE. It was <a class="card way">, and the
          Dubai link added inside the first one was a link inside a link —
          which HTML forbids, so the parser closed the card at the inner <a>.
          The card became four grid items: a truncated card, the Dubai link, a
          loose "." and the orphaned price line, which is why the row showed
          "Based in Dubai —" with nothing after it and pushed the other two
          cards onto a second row.

          Each card is a plain element now, with its heading as the link and a
          pseudo-element stretching that link over the whole card. The card is
          still one click target, and a second link inside it is simply a
          second link. */}
      <div class="ways" data-stagger>
        <div class="card way way--lead">
          <span class="way__k"><a class="way__main" href="/service">AI search (AEO)</a></span>
          <span class="way__d">Get named when buyers ask ChatGPT, Gemini, Perplexity and Google&rsquo;s AI Overviews.</span>
          <span class="way__d">Based in Dubai. See our <a class="way__in" href="/aeo-agency-dubai">AEO agency in Dubai</a> page.</span>
          <span class="way__p">Plans from <strong><span class="cur-aed">{money(PLANS[0].monthly).aed}</span><span class="cur-gbp">{money(PLANS[0].monthly).gbp}</span><span class="cur-usd">{money(PLANS[0].monthly).usd}</span></strong> a month</span>
        </div>
        <div class="card way">
          <span class="way__k"><a class="way__main" href="/service#seo">SEO</a></span>
          <span class="way__d">Rank on Google for the searches that bring buyers. Included in every plan.</span>
          <span class="way__p">Included</span>
        </div>
        <div class="card way">
          <span class="way__k"><a class="way__main" href="/ai-ready-websites">Websites built for both</a></span>
          <span class="way__d">New pages or a full rebuild on your platform, so Google and AI can read you.</span>
          <span class="way__p">Pages from <strong><span class="cur-aed">{money(WEB_PAGE.price).aed}</span><span class="cur-gbp">{money(WEB_PAGE.price).gbp}</span><span class="cur-usd">{money(WEB_PAGE.price).usd}</span></strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Logo strip — inverted band, pill label -->
  <LogoStrip />

  <!-- 3. The problem — centred intro, 2x2 cause-and-effect grid -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>From AI Search guesswork to growth you can actually measure.</h2>
        <p class="lede">
          Most marketing teams are stretched across enough channels as it is;
          AI Search landed on top of that, with no dashboard, no benchmark and
          nobody able to explain it.
        </p>
        <p class="lede section-head__kick">Any of these sound familiar? You&rsquo;re not alone.</p>
      </div>

      <div class="problem-grid" data-stagger>
        {PROBLEMS.map((p) => (
          <div class:list={['card', 'problem', `problem--${p.accent}`]}>
            <span class="problem__n" aria-hidden="true">{p.n}</span>
            <h3>{p.t}</h3>
            <p class="problem__p">{p.p}</p>
            <div class="problem__effect">
              <span class="problem__k">The effect</span>
              <p>{p.e}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3b. The prize. One number and what it means for the reader.
       THE SOURCE BLOCK WAS REMOVED ON JOE'S INSTRUCTION, 2026-08-29. It is
       still carried in PRIZE.source and PRIZE.caveat and is still the only
       reason the figure is on the site at all — it is not ours, it is Muck
       Rack's, and they sell PR software. Anyone editing this number must read
       those two fields before touching the claim. If the citation is wanted
       back on a page, /research is the place for it. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      {/* Not a card any more. Once the source block came off, the box had a
          third of its width doing nothing. A statistic this size does not need
          a container to be read as one — the number is the container. */}
      <figure class="prize">
        <div class="prize__stat">
          <span class="prize__n"><span data-count={PRIZE.n}>{PRIZE.n}</span><span class="prize__s">{PRIZE.suffix}</span></span>
          <p class="prize__claim">{PRIZE.claim}</p>
        </div>
        <p class="prize__point">{PRIZE.point}</p>
      </figure>
    </div>
  </section>

  <!-- 4. The four stages. Numbered cards on a coloured spine, each in its own
       brand hue, arriving in sequence as the spine draws through them. -->
  <section class="section stages">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>Delivering it in four stages, in the same order, every time.</h2>
        <p class="lede">Every engagement runs the same four stages, in the same order. We call it SCAN.</p>
      </div>

      <ol class="stages__track" data-timeline>
        <span class="stages__spine" aria-hidden="true"><span class="stages__fill"></span></span>
        {STAGES.map((st, i) => (
          <li class:list={['stages__item', `stages--${st.a}`]} style={`--i:${i}`}>
            <span class="stages__node" aria-hidden="true"></span>
            <article class="stages__card">
              <span class="stages__n" aria-hidden="true">{st.n}</span>
              <p class="stages__when">{st.w}</p>
              <h3 class="stages__t">{st.t}</h3>
              <p class="stages__d">{st.d}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Gradient CTA card, directly above pricing.
       REWRITTEN WHEN IT MOVED HERE, 2026-08-29. It used to sit between the
       problem grid and the demo, where "We fix all four" pointed back at the
       four problems and its lede was the first statement of the method. In
       this position it landed under "Delivering it in four stages" and read as
       a promise about the stages, with a lede restating the four cards
       immediately above it. Its job here is different: hand the reader into
       the prices, and say what the free entry point is. -->
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="cta-card">
        <span class="cta-card__glint" aria-hidden="true"><span class="cta-card__sheen"></span></span>
        <div>
          <h2>Every engagement starts with the same free measurement.</h2>
          <p class="lede">
            We measure it, tell you which of the three causes is keeping you out
            of the answer, and hand you the report. Nothing about it commits you
            to the prices below.
          </p>
        </div>
        <a class="btn cta-card__btn" href="#report">Get a free visibility report</a>
      </div>
    </div>
  </section>

  <!-- 6. Pricing — two cards, gradient headers, prices stated -->
  <section class="section section--sunk" id="pricing">
    <div class="wrap" data-reveal>
      <div class="section-head">
        {/* No subheading here, and none on /service either. The packages
            sections carry a price and a card list; a lede between the heading
            and the cards was hedging in front of the number. */}
        <h2>Two ways we get you there.</h2>
      </div>

      {/* A teaser, not the detail. The full artefact list per package lives on
          /service, which is the page organised around what you buy — repeating
          it here is what made three pages say the same thing. */}
      <div class="price-grid" data-stagger>
        {PACKAGES.map((o) => (
          <div class:list={['card', 'offer', o.primary && 'is-featured']}>
            {o.primary && <span class="feat-ring" aria-hidden="true"></span>}
            <div class="offer__head">
              <h3>{o.name}</h3>
              <span class="offer__price">{o.price}</span>
              <span class="offer__unit">{o.unit}</span>
            </div>
            <div class="offer__body">
              <p>{o.lede}</p>
              <ul>{o.teaser.map((i) => <li>{i}</li>)}</ul>
              {/* Both tiers say "Book a call", so both go to the booking form
                  on /service rather than one landing on the report form. */}
              <a class:list={['btn', !o.primary && 'btn--ghost']} href="/service#book">{o.cta}</a>
            </div>
          </div>
        ))}
      </div>
      <p class="center-row mt-1">
        <a class="textlink" href="/pricing">Full pricing &rarr;</a>
        <a class="textlink" href="/service#buy">Everything in both, in full &rarr;</a>
      </p>

      {/* The sample-pricing flag was removed here on 2026-09-03: these are the
          real figures from the pricing sheet, not placeholders. The terms line
          replaces it because a six-month term and a 90-day break clause are
          part of the price and belong beside it. */}
      <p class="center-row mt-2"><span class="note-sm">{TERMS}</span></p>
    </div>
  </section>

  <!-- 7. Six surfaces. Real prompts by sector, rotating.
       This was four bracketed placeholder rows. A placeholder prompt shows the
       table's shape and nothing else; a real one shows what the product is,
       which is the point of the section. -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2 class="statement statement--sub">Providing everything you need to grow through AI Search.</h2>
        <p class="lede">
          One question. Six different answers. Across six engines. Different
          companies named each time, built from different sources. Pick a sector
          and see.
        </p>
      </div>
      <PromptRotator />
    </div>
  </section>

  <!-- 8. Research teaser -->
  <section class="section">
    <div class="wrap" data-reveal>
      <div class="section-head">
        <h2>We publish what we measure</h2>
        <p class="lede">Method attached to every piece, so you can check it or run it yourself instead of taking our word for it.</p>
      </div>
      <div class="grid grid--3" data-stagger>
        {pieces.map((p) => (
          <a class="card card--link card--tilt" href={`/research/${p.id}`}>
            <p class="meta">
              <time datetime={sortDate(p).toISOString().slice(0, 10)}>{sortDate(p).toISOString().slice(0, 10)}</time>
              <span class="tag">{tagFor(p)}</span>
              {p.data.placeholder && <span class="tag tag--draft">Placeholder</span>}
            </p>
            <h3>{p.data.title}</h3>
            <p class="note-sm mb-0">{p.data.description}</p>
          </a>
        ))}
      </div>
      <p class="center-row mt-2"><a class="textlink" href="/research">All research &rarr;</a></p>
    </div>
  </section>

  <!-- 8b. Client quotes, between the research teaser and the questions. -->
  <Testimonials />

  <!-- 9. Objections — a subset. The full set lives on /faq. -->
  <section class="section section--sunk">
    <div class="wrap-narrow" data-reveal>
      <div class="section-head">
        <h2>Questions people ask us</h2>
      </div>
      <div class="qa" data-stagger>
        {FAQS_HOME.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="center-row mt-2">
        <a class="btn btn--ghost" href="/faq">See all {FAQS.length} questions</a>
      </p>
    </div>
  </section>

  {/* 9b. Pricing teaser, immediately before the closing CTA. */}
  <section class="section section--tight">
    <div class="wrap" data-reveal>
      <div class="pteas">
        <p class="pteas__t">
          Plans from
          <strong><span class="cur-aed">{money(PLANS[0].monthly).aed}</span><span class="cur-gbp">{money(PLANS[0].monthly).gbp}</span><span class="cur-usd">{money(PLANS[0].monthly).usd}</span></strong>
          a month. Build yours in under a minute.
        </p>
        <a class="btn" href="/pricing">Build your plan</a>
      </div>
    </div>
  </section>

  <!-- 10. CTA — INVERTED band, full section -->
  <section class="section" id="report">
    <div class="wrap">
      <div class="hero-grid">
        <div data-reveal>
          {/* THIS BLOCK IS THE CANONICAL FORM SECTION. It is repeated verbatim
              on /service and /faq — same heading, same lede — because the ask
              is the same ask and three different framings of it read as three
              different offers. Change it here and change it there. */}
          <h2 class="statement statement--sub" data-split>Find out what AI Search is telling your buyers right now.</h2>
          <p class="lede">
            Your category across all six engines. Who gets named, in what
            order, and where each answer came from. It is a top-level read,
            it is free, and there is no obligation attached to it.
          </p>
        </div>
        <ReportForm id="report-form" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Three ways in. Existing .card surface, existing type scale; the lead card
     is marked with the accent border already used for a selected plan rather
     than a new treatment. */
  .ways { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 46rem) { .ways { grid-template-columns: repeat(3, 1fr); } }
  .way {
    position: relative;
    display: grid; gap: 0.45rem; align-content: start;
    padding: 1.25rem 1.3rem; color: inherit;
    border: 1px solid var(--border);
    transition: border-color 140ms ease, transform 140ms ease;
  }
  .way:hover { border-color: var(--muted); transform: translateY(-2px); }
  .way--lead { border-color: var(--accent); border-width: 2px; }
  .way__k { font-family: var(--font-display); font-weight: 700; font-size: var(--h3); letter-spacing: -0.015em; }
  /* The heading's link covers the card, so the whole card is still one target
     and the link still has a real name for a screen reader. */
  .way__main { color: inherit; text-decoration: none; }
  .way__main::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .way:has(.way__main:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .way__main:focus-visible { outline: none; }
  /* Sits above that overlay so it is clickable in its own right. */
  .way__in { position: relative; z-index: 1; }
  .way__d { font-size: var(--small); color: var(--muted); }
  .way__p { font-size: var(--small); margin-top: 0.25rem; }

  .pteas {
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center;
    justify-content: space-between;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface-sunk); padding: 1.1rem 1.35rem;
  }
  .pteas__t { margin: 0; }
</style>
