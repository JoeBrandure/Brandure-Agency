---
import { PLANS, SETUP_FEE, ADDONS, VAT_TERMS, NUDGE_FROM_PAGES, money } from '../data/pricing';
import PlanCards from './PlanCards.astro';

/**
 * The price builder — the page's main content, not an extra below it.
 *
 * STRUCTURE. Choices on the left, a summary on the right that sticks on
 * desktop and becomes a bottom bar on mobile. Three numbered steps: plan,
 * setup (fixed), website work (optional).
 *
 * NATIVE INPUTS THROUGHOUT. The plan cards and the website tiles are labels
 * wrapping real radio inputs, so they are keyboard-operable, announce as a
 * radio group, and still render as a readable set of choices with JS off. The
 * card appearance is :has()-driven off the checked input rather than a class
 * the script maintains — one less thing to desynchronise.
 *
 * WITHOUT JS the choices render and the summary says "See the full price list
 * below" instead of a total it cannot compute. Nothing is hidden: the complete
 * list, in both currencies, is further down the page.
 *
 * NO LAYOUT SHIFT. The summary renders server-side with the Core defaults
 * already in place, so every box is final-size before the script runs; the
 * script only rewrites the numbers inside. Totals change with a short opacity
 * fade, never a reflow.
 *
 * Prices come from src/data/pricing.ts — the same module the full list and the
 * schema read, so the builder cannot total a figure the page does not print.
 */
const rates = {
  plans: Object.fromEntries(PLANS.map((p) => [p.key, p.monthly])),
  setup: SETUP_FEE.price,
  addons: Object.fromEntries(ADDONS.filter((a) => a.price).map((a) => [a.key, a.price])),
  nudgeFrom: NUDGE_FROM_PAGES,
};

const page = ADDONS.find((a) => a.key === 'page')!;
const r10 = ADDONS.find((a) => a.key === 'rebuild10')!;
const r20 = ADDONS.find((a) => a.key === 'rebuild20')!;
const copyAddon = ADDONS.find((a) => a.key === 'copy')!;

const TILES = [
  { key: 'none', label: 'No website work', price: null, hint: 'My site is fine' },
  { key: 'page', label: 'New pages', price: page.price, hint: 'per page' },
  { key: 'rebuild10', label: 'Rebuild, up to 10 pages', price: r10.price, hint: 'one-off' },
  { key: 'rebuild20', label: 'Rebuild, up to 20 pages', price: r20.price, hint: 'one-off' },
  { key: 'ecommerce', label: 'Ecommerce / 20+ pages', price: null, hint: 'Quoted' },
];

const money2 = (m: { aed: number; gbp: number }) => money(m);
const setup0 = money(SETUP_FEE.price);
const monthly0 = money(PLANS[0].monthly);
---
<section class="section pbx-sec" id="builder" aria-labelledby="pbx-h">
  <div class="wrap">
    <h2 class="sr-only" id="pbx-h">Build your plan</h2>

    <form class="pbx" id="price-builder">
      <div class="pbx__main">
        <!-- 1 · Plan -->
        <fieldset class="pbx__step">
          <legend class="pbx__lg"><span class="pbx__n" aria-hidden="true">1</span> Choose your plan</legend>
          <div class="pbx__plans">
            <PlanCards mode="choose" />
          </div>
        </fieldset>

        <!-- 2 · Setup -->
        <fieldset class="pbx__step">
          <legend class="pbx__lg"><span class="pbx__n" aria-hidden="true">2</span> Setup <span class="pbx__inc">included</span></legend>
          <div class="scard">
            <span class="scard__tick" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <span>
              <strong>{SETUP_FEE.name}: <span class="cur-aed">{setup0.aed}</span><span class="cur-gbp">{setup0.gbp}</span><span class="cur-usd">{setup0.usd}</span></strong>, one-off, 10 working days
              <span class="scard__d">Technical SEO, schema, AI crawler access, entity fixes, tracking and your visibility baseline.</span>
            </span>
          </div>
        </fieldset>

        <!-- 3 · Website -->
        <fieldset class="pbx__step">
          <legend class="pbx__lg"><span class="pbx__n" aria-hidden="true">3</span> Website work <span class="pbx__inc">optional</span></legend>
          <div class="pbx__tiles">
            {TILES.map((t, i) => (
              <label class="tile">
                <input type="radio" name="web" value={t.key} checked={i === 0} />
                <span class="tile__in">
                  <span class="tile__l">{t.label}</span>
                  <span class="tile__p">
                    {t.price
                      ? <><span class="cur-aed">{money2(t.price).aed}</span><span class="cur-gbp">{money2(t.price).gbp}</span><span class="cur-usd">{money2(t.price).usd}</span> {t.hint}</>
                      : t.hint}
                  </span>
                </span>
              </label>
            ))}
          </div>

          {/* THE INPUT IS STILL THE FIELD. Both of these were bare
              type="number" boxes: browser-default chrome, a ~20px tap target
              and spinner arrows a thumb cannot hit. The native input stays —
              it carries the value, it is what no-JS gets, and tapping it still
              brings up the numeric keypad — and the stepper is built around
              it: a 44px minus, the field at 44px, a 44px plus. The buttons are
              inert without the script, so they only appear once the form is
              marked ready. */}
          <div class="pbx__sub" id="pbx-pages-row" hidden>
            <label class="pbx__lb" for="pb-pages">How many pages?</label>
            <div class="pbx__spin">
              <button type="button" class="pbx__sbtn" data-spin="pb-pages" data-by="-1" aria-label="Fewer pages">&minus;</button>
              <input id="pb-pages" name="pages" type="number" min="1" max="10" step="1" value="1" inputmode="numeric" />
              <button type="button" class="pbx__sbtn" data-spin="pb-pages" data-by="1" aria-label="More pages">+</button>
            </div>
          </div>

          {/* The nudge said a rebuild was better value and then left you to
              find the tile yourself. The button is static markup and only the
              sentence is rewritten, so this live region announces the advice
              rather than re-announcing its own control. */}
          <p class="pbx__nudge" id="pb-nudge" hidden role="status">
            <span id="pb-nudge-t"></span>
            <button type="button" class="pbx__nbtn" id="pb-nudge-go">Switch to rebuild</button>
          </p>

          <div class="pbx__sub" id="pbx-copy-row" hidden>
            <label class="pbx__lb" for="pb-copy">
              Need copy written? <span class="note-sm">(+<span class="cur-aed">{money2(copyAddon.price).aed}</span><span class="cur-gbp">{money2(copyAddon.price).gbp}</span><span class="cur-usd">{money2(copyAddon.price).usd}</span> per page)</span>
            </label>
            <div class="pbx__spin">
              <button type="button" class="pbx__sbtn" data-spin="pb-copy" data-by="-1" aria-label="Fewer copywriting pages">&minus;</button>
              <input id="pb-copy" name="copy" type="number" min="0" max="20" step="1" value="0" inputmode="numeric" />
              <button type="button" class="pbx__sbtn" data-spin="pb-copy" data-by="1" aria-label="More copywriting pages">+</button>
            </div>
          </div>
        </fieldset>
      </div>

      <!-- Summary -->
      <aside class="pbx__sum" id="pbx-sum" aria-live="polite">
        {/* THE BAR NEEDED A WAY OUT OF ITSELF. On a phone this is the whole
            summary: two totals and a chevron, with the only CTA inside a panel
            you had to guess was there. The button sits beside the totals as a
            sibling — not nested, because an <a> inside a <button> is invalid
            and neither control would be reliably operable. Tapping the totals
            still expands the panel. */}
        <div class="pbx__bar">
          <button type="button" class="pbx__peek" id="pbx-peek" aria-expanded="false" aria-controls="pbx-sumbody">
            <span class="pbx__peekrow">
              <span><span class="pbx__peekl">Setup</span> <strong id="pb-setup-m"><span class="cur-aed">{setup0.aed}</span><span class="cur-gbp">{setup0.gbp}</span><span class="cur-usd">{setup0.usd}</span></strong></span>
              <span><span class="pbx__peekl">Monthly</span> <strong id="pb-monthly-m"><span class="cur-aed">{monthly0.aed}</span><span class="cur-gbp">{monthly0.gbp}</span><span class="cur-usd">{monthly0.usd}</span></strong></span>
            </span>
            <span class="pbx__chev" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
            </span>
          </button>
          <a class="btn pbx__barcta" id="pb-cta-m" href="/service#book">Book a call</a>
        </div>

        <div class="pbx__sumbody" id="pbx-sumbody">
          <p class="pbx__big">
            <span class="pbx__biglb">Setup today</span>
            <strong id="pb-setup"><span class="cur-aed">{setup0.aed}</span><span class="cur-gbp">{setup0.gbp}</span><span class="cur-usd">{setup0.usd}</span></strong>
          </p>
          <p class="pbx__big">
            <span class="pbx__biglb">Then</span>
            <strong id="pb-monthly"><span class="cur-aed">{monthly0.aed}</span><span class="cur-gbp">{monthly0.gbp}</span><span class="cur-usd">{monthly0.usd}</span></strong>
            <span class="pbx__per">/month</span>
          </p>

          <ul class="pbx__lines" id="pb-lines">
            <li><span>{SETUP_FEE.name}</span><span><span class="cur-aed">{setup0.aed}</span><span class="cur-gbp">{setup0.gbp}</span><span class="cur-usd">{setup0.usd}</span></span></li>
            <li><span>{PLANS[0].name} plan</span><span><span class="cur-aed">{monthly0.aed}</span><span class="cur-gbp">{monthly0.gbp}</span><span class="cur-usd">{monthly0.usd}</span>/mo</span></li>
          </ul>

          <p class="note-sm pbx__terms">{VAT_TERMS}</p>
          <p class="pbx__cta"><a class="btn" id="pb-cta" href="/service#book">Book a call with this plan</a></p>
          <p class="note-sm pbx__nojs">See the full price list below for every figure in AED, pounds and dollars.</p>
        </div>
      </aside>
    </form>
  </div>
</section>

<script is:inline define:vars={{ rates }}>
  (function () {
    var form = document.getElementById('price-builder');
    if (!form) return;
    /* Runs during parse, before paint: marking ready here reveals the computed
       summary without a shift. Not keyed off .no-js — the motion layer owns
       that class and a failure there must not disable the builder. */
    form.setAttribute('data-ready', '1');

    /* EVERY FIGURE IS A MONEY OBJECT, not a pair of named numbers. The
       arithmetic below used to carry .aed and .gbp by hand on every line,
       which meant adding dollars would have meant touching all of it and
       getting one line wrong would have been a quiet mispricing. Currencies
       are a list now: adding a fourth means adding it to CUR and fmt. */
    var CUR = ['aed', 'gbp', 'usd'];
    var fmt = {
      aed: function (n) { return 'AED ' + n.toLocaleString('en-GB'); },
      gbp: function (n) { return '£' + n.toLocaleString('en-GB'); },
      usd: function (n) { return '$' + n.toLocaleString('en-GB'); },
    };
    /* All three go into the markup; the CSS shows the chosen one. */
    function price(m) {
      var out = '';
      CUR.forEach(function (c) {
        out += '<span class="cur-' + c + '">' + fmt[c](m[c]) + '</span>';
      });
      return out;
    }
    function zero() { return { aed: 0, gbp: 0, usd: 0 }; }
    function add(into, m, mult) {
      CUR.forEach(function (c) { into[c] += m[c] * (mult === undefined ? 1 : mult); });
      return into;
    }
    function times(m, k) { return add(zero(), m, k); }
    var $ = function (id) { return document.getElementById(id); };
    var pagesRow = $('pbx-pages-row'), pages = $('pb-pages');
    var copyRow = $('pbx-copy-row'), copy = $('pb-copy');
    var nudge = $('pb-nudge'), nudgeT = $('pb-nudge-t'), nudgeGo = $('pb-nudge-go');
    var lines = $('pb-lines');
    var cta = $('pb-cta'), ctaM = $('pb-cta-m');

    /* How many pages the chosen website work actually covers — the ceiling on
       copywriting, since copy is priced per page. It was a flat 20, so a
       10-page rebuild would happily take copy for twenty pages. */
    function pageCount(web, n) {
      if (web === 'page') return n;
      if (web === 'rebuild10') return 10;
      if (web === 'rebuild20' || web === 'ecommerce') return 20;
      return 0;
    }

    function state() {
      var plan = form.querySelector('input[name="plan"]:checked').value;
      var web = form.querySelector('input[name="web"]:checked').value;
      var n = Math.max(1, Math.min(10, Number(pages.value) || 1));
      var cap = pageCount(web, n);
      return {
        plan: plan,
        web: web,
        pages: web === 'page' ? n : 0,
        cap: cap,
        copy: web === 'none' ? 0 : Math.max(0, Math.min(cap, Number(copy.value) || 0)),
      };
    }

    function compute(s) {
      var out = { total: add(zero(), rates.setup), quote: false, items: [] };
      out.items.push(['AI search & SEO setup', rates.setup, '']);
      if (s.web === 'page') {
        add(out.total, rates.addons.page, s.pages);
        out.items.push([s.pages + (s.pages === 1 ? ' new page' : ' new pages'), times(rates.addons.page, s.pages), '']);
      } else if (s.web === 'rebuild10' || s.web === 'rebuild20') {
        add(out.total, rates.addons[s.web]);
        out.items.push([s.web === 'rebuild10' ? 'Rebuild, up to 10 pages' : 'Rebuild, up to 20 pages', rates.addons[s.web], '']);
      } else if (s.web === 'ecommerce') {
        /* Floor only: setup plus the up-to-10 rebuild. The rest is quoted, so
           this is never presented as a total. */
        add(out.total, rates.addons.rebuild10);
        out.quote = true;
        out.items.push(['Ecommerce build', rates.addons.rebuild10, 'from']);
      }
      if (s.copy > 0) {
        add(out.total, rates.addons.copy, s.copy);
        out.items.push(['Copywriting, ' + s.copy + (s.copy === 1 ? ' page' : ' pages'), times(rates.addons.copy, s.copy), '']);
      }
      return out;
    }

    /* A TIMER PER ELEMENT. One shared handle meant flashing the desktop total
       and then the mobile one cancelled the first element's cleanup, so
       #pb-setup kept .is-upd and sat at opacity 0.45 for good — which is why
       "Setup today" read grey while "Then" read black. They are the same
       colour and weight; one of them was simply stuck mid-transition. */
    var fading = new WeakMap();
    function flash(el) {
      el.classList.add('is-upd');
      clearTimeout(fading.get(el));
      fading.set(el, setTimeout(function () { el.classList.remove('is-upd'); }, 220));
    }

    function render() {
      var s = state();
      pagesRow.hidden = s.web !== 'page';
      copyRow.hidden = s.web === 'none';
      copy.max = String(s.cap);
      if (Number(copy.value) > Number(copy.max)) copy.value = copy.max;
      /* The ends of each range are dead, and saying so with disabled is
         clearer than a button that looks live and does nothing. */
      spinState(pages);
      spinState(copy);

      var show = s.web === 'page' && s.pages >= rates.nudgeFrom;
      nudge.hidden = !show;
      if (show) {
        nudgeT.innerHTML = 'A full rebuild up to 10 pages is better value at ' +
          price(rates.addons.rebuild10) + '. ';
      }

      var t = compute(s), m = rates.plans[s.plan];
      /* The approved copy states this exactly: ecommerce shows a floor and
         says the rest is quoted, in the headline figure itself rather than
         only in the line items. */
      var setupHtml = t.quote
        ? 'from ' + price(t.total) + ' <span class="pbx__q">+ quote</span>'
        : price(t.total);
      ['pb-setup', 'pb-setup-m'].forEach(function (id) { $(id).innerHTML = setupHtml; flash($(id)); });
      ['pb-monthly', 'pb-monthly-m'].forEach(function (id) { $(id).innerHTML = price(m); });

      var html = '';
      t.items.forEach(function (it) {
        html += '<li><span>' + it[0] + '</span><span>' + (it[2] ? it[2] + ' ' : '') + price(it[1]) + '</span></li>';
      });
      html += '<li><span>' + (s.plan === 'growth' ? 'Growth' : 'Core') + ' plan</span><span>' + price(m) + '/mo</span></li>';
      if (t.quote) html += '<li><span>Ecommerce scope</span><span>Quoted</span></li>';
      lines.innerHTML = html;

      cta.textContent = t.quote ? 'Get a quote' : 'Book a call with this plan';
      /* The bar has room for three words, not five. Same destination, same
         selection — set from the same href below. */
      ctaM.textContent = t.quote ? 'Get a quote' : 'Book a call';

      /* The form and the Calendly attribution get the currency the visitor is
         actually reading, not the build default. */
      var cur = document.documentElement.getAttribute('data-cur');
      if (CUR.indexOf(cur) < 0) cur = 'usd';
      var q = {
        plan: s.plan === 'growth' ? 'Growth' : 'Core',
        pages: String(s.pages),
        rebuild: s.web,
        copywriting: String(s.copy),
        setup_total: (t.quote ? 'from ' : '') + fmt[cur](t.total[cur]) + (t.quote ? ' + quote' : ''),
        monthly_total: fmt[cur](m[cur]),
        currency: cur.toUpperCase(),
      };
      /* Query before fragment: '#book?x=1' buries the query in the fragment.
         Built once and set on both, because reading back `cta.href` returns
         the resolved absolute URL — copying that to the bar button would bake
         the current origin into the markup and leave the two links carrying
         different hrefs for the same destination. */
      var href = '/service?' + new URLSearchParams(q).toString() + '#book';
      cta.href = href;
      ctaM.href = href;
      try { sessionStorage.setItem('brandure.plan', JSON.stringify(q)); } catch (e) { /* link carries it */ }
    }

    /* ---- Steppers ----
       One delegated handler for both fields. The input stays the single source
       of truth — a button only nudges its value and re-renders, so there is no
       second copy of the number that could fall out of step with the field a
       visitor can still type into. */
    function spinState(el) {
      var v = Number(el.value) || 0;
      var row = el.parentNode;
      var minus = row.querySelector('[data-by="-1"]');
      var plus = row.querySelector('[data-by="1"]');
      if (minus) minus.disabled = v <= Number(el.min);
      if (plus) plus.disabled = v >= Number(el.max);
    }

    form.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-spin]');
      if (!btn) return;
      e.preventDefault();
      var el = $(btn.getAttribute('data-spin'));
      var next = (Number(el.value) || 0) + Number(btn.getAttribute('data-by'));
      next = Math.max(Number(el.min), Math.min(Number(el.max), next));
      if (String(next) === el.value) return;
      el.value = String(next);
      render();
    });

    /* The nudge now does the thing it advises. */
    nudgeGo.addEventListener('click', function (e) {
      e.preventDefault();
      var tile = form.querySelector('input[name="web"][value="rebuild10"]');
      if (!tile) return;
      tile.checked = true;
      render();
      /* The tile row is above the nudge, so move focus to what just changed
         rather than leaving it on a button that has disappeared. */
      tile.focus({ preventScroll: true });
    });

    form.addEventListener('input', render);
    form.addEventListener('change', render);
    document.addEventListener('brandure:currency', render);

    /* The cookie banner is also pinned to the bottom. Rather than move this
       bar out of its way — which animated a fixed element and scored 0.035 of
       layout shift — the bar publishes its height and the banner sits above
       it. The bar never moves, so it never shifts.

       THE HEIGHT STAYS PUBLISHED EVEN WHILE THE BAR IS SLID AWAY. Clearing it
       when the bar leaves would drop the banner by a bar's height, and moving
       a fixed element between frames is a layout shift whether it is animated
       or jumped — that is exactly the 0.035 this arrangement was built to
       avoid. The cost is a banner sitting one bar-height up while the bar is
       hidden, which only happens with the banner still undismissed below the
       builder; CLS stays 0, which is the trade worth making. */
    var sum = document.getElementById('pbx-sum');
    function publishHeight() {
      var fixed = getComputedStyle(sum).position === 'fixed';
      document.documentElement.style.setProperty(
        '--pbx-bar-h', fixed ? sum.getBoundingClientRect().height + 'px' : '0px');
    }
    addEventListener('resize', publishHeight);
    publishHeight();

    var peek = document.getElementById('pbx-peek');
    peek.addEventListener('click', function () {
      var open = document.getElementById('pbx-sum').classList.toggle('is-open');
      peek.setAttribute('aria-expanded', String(open));
    });

    /* ---- The bar belongs to the builder, not to the page ----
       It appears when the builder section comes into view and leaves once the
       section has gone, so it never covers the FAQs or the footer. The
       observer watches the section rather than the viewport scroll position:
       no scroll handler, and the browser does the geometry.

       data-off rather than a class, so the CSS reads as a state and not as
       another thing the script and the stylesheet have to agree about. */
    var sec = document.getElementById('builder');
    if (sec && 'IntersectionObserver' in window) {
      sum.setAttribute('data-off', '');
      new IntersectionObserver(
        function (entries) {
          if (entries[0].isIntersecting) sum.removeAttribute('data-off');
          else {
            sum.setAttribute('data-off', '');
            /* A bar sliding away while its own panel is open would take the
               breakdown with it and come back open. */
            sum.classList.remove('is-open');
            peek.setAttribute('aria-expanded', 'false');
          }
        },
        /* A little slack at the bottom, so the bar is already there as the
           first step scrolls up rather than arriving a beat late. */
        { rootMargin: '0px 0px -10% 0px' },
      ).observe(sec);
    }

    render();
  })();
</script>

<style>
  /* Everything below is built from existing tokens: --surface, --surface-sunk,
     --border, --accent, --radius, the type scale and the .btn classes. No new
     colours, no new type sizes. */
  .pbx-sec { padding-top: 1rem; }
  /* The ~137px under the tiles was never reserved stepper space — the stepper
     is display:none when hidden, and the gap measured identically in both
     states. It was the last fieldset's margin plus the section's own bottom
     padding, which reads as dead space because the tile row is short. Trimmed
     here rather than reserved anywhere. Static CSS, so CLS stays 0. */
  .pbx-sec { padding-bottom: 1.75rem; }
  .pbx__step:last-of-type { margin-bottom: 0; }

  /* ONE CENTRED COLUMN. It was choices on the left and a sticky summary
     column on the right, which left the three steps hugging the left edge of
     a wide page and the totals in a panel most of a screen away from the
     thing being priced. The summary is the bottom bar on every device now, so
     the steps get the whole column and sit in the middle of it. */
  .pbx { display: block; max-width: var(--wrap-narrow); margin-inline: auto; }
  .pbx__main { display: block; }

  .pbx__step { border: 0; padding: 0; margin: 0 0 1.75rem; }
  /* The numbered legend centres with its step. `display: flex` on a <legend>
     needs the centring on the flex box itself, not text-align. */
  .pbx__lg { display: flex; align-items: center; justify-content: center; gap: 0.55rem; padding: 0; margin-bottom: 0.85rem; font-family: var(--font-display); font-weight: 700; font-size: var(--h3); letter-spacing: -0.015em; text-align: center; }
  .pbx__n { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--surface-sunk); border: 1px solid var(--border); font-family: var(--font-mono); font-size: var(--label); font-weight: 400; }
  .pbx__inc { font-family: var(--font-mono); font-size: var(--label); font-weight: 400; letter-spacing: 0.05em; color: var(--muted); }

  /* Plan cards: native radio, :has() drives the selected look. The card
     itself now lives in global.css, because /aeo-agency-dubai shows the same
     two cards as links — a scoped style could not reach it. Only the layout
     of the pair is this component's business. */
  .pbx__plans { display: grid; gap: 0.9rem; max-width: 42rem; margin-inline: auto; }
  @media (min-width: 40rem) { .pbx__plans { grid-template-columns: 1fr 1fr; } }

  /* Setup: fixed, always ticked. */
